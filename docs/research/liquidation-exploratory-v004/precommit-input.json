  "stage": "CORE_PREMISE",
  "phenomenon": "Completed daily observed Binance forced-liquidation stress identifies an already known deleveraging episode. Subsequent 4h price acceptance or reclaim may distinguish continuation from reversal after conservative publication lag.",
  "economic_behavioral_mechanism": "Margin-constrained participants close urgently. Some effects may persist after a stress day has completed and its daily aggregate is available. Subsequent confirmed structure can distinguish persistent repricing from temporary dislocation. Daily aggregation does not recover intraday cascade timing; the surviving delayed edge, if any, must be tested.",
  "participants": {
    "forced_actor": "Leveraged holders subject to margin calls or involuntary liquidation",
    "edge_provider": "Price-insensitive forced closers and liquidity takers requiring immediate execution",
    "edge_consumer": "Patient, risk-constrained entrant waiting for post-event structure"
  },
  "persistence": "Forced execution and temporarily constrained market-maker inventories can outlast instantaneous arbitrage; whether enough delay remains after hourly confirmation is the main empirical question.",
  "crowding_decay": "Faster absorption, improved arbitrage or crowded reclaim/pullback entries can consume the effect before confirmation and make net expectancy nonpositive.",
  "direction": "Conditional long and short: continuation follows the extreme move after acceptance; reversal opposes it after reclaim; ambiguous structure means no trade.",
  "expression": "Binance USDT linear perpetuals on BTC, ETH, SOL, AAVE, UNI, BNB, LINK, ZEC, TRX; isolated margin; unchanged conditional/staged rules.",
  "holding_horizon": {
    "min": 0,
    "max": 60,
    "unit": "days",
    "clock": "From first fill; never reset by additions; stops may close immediately"
  },
  "expected_signal_frequency": {
    "min": 1,
    "max": 4,
    "unit": "market episodes per month across frozen nine-asset universe",
    "basis": "Inherited 1\u20134 range is an unvalidated premise prediction, already missed by exposed four-asset v003. Retained rather than fitted to observed returns; added correlated assets are not independent replications."
  },
  "expected_win_rate": {
    "min": 0.35,
    "max": 0.55
  },
  "payoff": {
    "average_win_r": {
      "min": 1.3,
      "max": 2.8
    },
    "average_loss_r": {
      "min": -1.3,
      "max": -0.7
    },
    "qualitative_shape": "Reversal returns capped by recovery target; continuation potentially right-skewed, with trailing giveback; gaps can lose more than 1R. R is initial tranche risk for core and frozen total position risk for staged comparisons; both also report dollars."
  },
  "regimes": {
    "expected_to_work": [
      "Liquidation pressure with subsequent stable absorption",
      "Persistent directional order flow distinguishable by post-shock acceptance"
