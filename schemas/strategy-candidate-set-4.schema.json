{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-candidate-set/4",
  "type": "object",
  "required": ["schema", "precommit_sha256", "generator", "declared_k", "effective_k", "candidates", "aliases", "accounting", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-candidate-set/4"},
    "precommit_sha256": {"type":"string", "pattern":"^[a-f0-9]{64}$"},
    "generator": {"type":"object", "required":["method","seed","declared_trials","provenance"], "properties":{"method":{"enum":["GRID","RANDOM","GENETIC","ML"]},"seed":{"type":"integer"},"declared_trials":{"type":"integer","minimum":1},"provenance":{"type":"object"}}, "additionalProperties":true},
    "declared_k":{"type":"integer","minimum":1}, "effective_k":{"type":"integer","minimum":1},
    "candidates":{"type":"array","minItems":1,"items":{"type":"object","required":["candidate_id","definition","hypothesis_index","generator","behavior_sha256"],"properties":{"candidate_id":{"type":"string"},"definition":{"type":"object"},"hypothesis_index":{"type":"integer"},"generator":{"type":"string"},"behavior_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"model_provenance":{"type":["object","null"]}},"additionalProperties":true}},
    "aliases":{"type":"array","items":{"type":"object","required":["behavior_sha256","candidate_ids"],"properties":{"behavior_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"candidate_ids":{"type":"array","minItems":1}},"additionalProperties":false}},
    "accounting":{"type":"object"}, "content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }, "additionalProperties":false
}
