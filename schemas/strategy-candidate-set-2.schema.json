{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-candidate-set/2",
  "type": "object",
  "required": ["schema", "experiment_id", "stage", "parent_evidence_sha256", "declared_k", "effective_k", "declared_sha256", "effective_sha256", "declared_candidates", "candidates"],
  "properties": {
    "schema": { "const": "strategy-candidate-set/2" },
    "experiment_id": { "type": "string" },
    "stage": { "enum": ["CORE_PREMISE", "ENTRY_TIMING", "RISK_LIFECYCLE", "INDEPENDENT_CONTEXT", "COMPOSITE_SCORE"] },
    "parent_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "declared_k": { "type": "integer", "minimum": 1 },
    "effective_k": { "type": "integer", "minimum": 1 },
    "declared_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "effective_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parameter_topology_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "declared_candidates": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["candidate_id", "behavior_sha256", "definition"], "properties": { "candidate_id": { "type": "string", "minLength": 1 }, "behavior_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "definition": { "type": "object" } } } },
    "candidates": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["candidate_id", "behavior_sha256", "stage", "hypothesis_family", "evidence_family_ids", "ablation_role", "definition"] } }
  },
  "additionalProperties": true
}
