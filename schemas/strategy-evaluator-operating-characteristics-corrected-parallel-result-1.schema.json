    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "measured": {"type": "boolean"},
    "planned_slots": {"type": "integer", "minimum": 0},
    "completed_slots": {"type": "integer", "minimum": 0},
    "missing_slots": {"type": "integer", "minimum": 0},
    "result_refs": {"type": "array", "items": {"type": "object"}},
    "missing": {"type": "array", "items": {"type": "object"}},
    "requested_workers": {"type": "integer", "minimum": 1},
    "effective_workers": {"type": "integer", "minimum": 1},
    "ledger_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resource_measurement": {"$ref": "#/$defs/resourceMeasurement"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "resourceMeasurement": {
      "type": "object",
