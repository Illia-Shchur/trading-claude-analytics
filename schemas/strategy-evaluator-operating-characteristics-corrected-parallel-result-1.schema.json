      "properties": {
        "schema": {"const": "strategy-evaluator-resource-measurement/1"},
        "version": {"const": 1},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ledger_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "executor_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "executor_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "host_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
