{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-run/5",
  "type": "object",
  "required": ["schema", "version", "provenance", "pipeline", "lineage", "manifest_sha256", "feature_rows_sha256", "label_rows_sha256", "execution_rows_sha256", "mark_rows_sha256", "candidate_metrics", "accounting", "decision", "gate_status", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-research-run/5" },
    "version": { "const": 1 },
    "provenance": { "enum": ["AUTHORITATIVE_RECOMPUTED", "AUTHORITATIVE_BLOCKED"] },
    "strategy_family_id": { "type": ["string", "null"], "minLength": 1 },
    "strategy_version": { "type": ["string", "null"], "minLength": 1 },
    "experiment_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE", null] },
    "asset_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pipeline": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "enum": ["features", "signal_intent", "labels", "execution_fills", "trades", "metrics", "stresses", "portfolio", "wfo"] } },
    "lineage": {
      "type": "object",
      "required": ["manifest_sha256", "feature_rows_sha256", "label_rows_sha256", "execution_rows_sha256", "mark_rows_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/hash" },
        "envelope_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_domain_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_hydration_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_partition_root_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "candidate_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "feature_rows_sha256": { "$ref": "#/$defs/hash" },
        "label_rows_sha256": { "$ref": "#/$defs/hash" },
        "execution_rows_sha256": { "$ref": "#/$defs/hash" },
        "mark_rows_sha256": { "$ref": "#/$defs/hash" },
        "wfo_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "manifest_sha256": { "$ref": "#/$defs/hash" },
    "envelope_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "opportunity_domain_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "opportunity_hydration_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "opportunity_partition_root_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "cutoff": { "type": ["string", "null"], "format": "date-time" },
    "feature_rows_sha256": { "$ref": "#/$defs/hash" },
    "label_rows_sha256": { "$ref": "#/$defs/hash" },
    "execution_rows_sha256": { "$ref": "#/$defs/hash" },
    "mark_rows_sha256": { "$ref": "#/$defs/hash" },
    "candidate_metrics": { "type": "array", "items": { "$ref": "#/$defs/candidateMetric" } },
    "accounting": {
      "type": "object",
      "required": ["declared_k", "evaluated_k", "market_episode_count", "zero_episode_binding"],
      "properties": { "declared_k": { "type": "integer", "minimum": 0 }, "evaluated_k": { "type": "integer", "minimum": 0 }, "current_evaluation_attempt_k": { "type": "integer", "minimum": 0 }, "current_evaluation_attempt_inventory_sha256": { "$ref": "#/$defs/hash" }, "cumulative_family_k": { "type": "integer", "minimum": 0 }, "candidate_metric_count": { "type": "integer", "minimum": 0 }, "candidate_metric_inventory_sha256": { "$ref": "#/$defs/hash" }, "market_episode_count": { "type": "integer", "minimum": 0 }, "zero_episode_binding": { "const": true } },
      "additionalProperties": false
    },
    "wfo": { "type": "object", "required": ["pass"], "properties": { "pass": { "type": "boolean" }, "status": { "type": "string" }, "reason": { "type": "string" } }, "additionalProperties": true },
    "execution_fills_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "selected_trades_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "stresses_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "portfolio_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "oos_artifact_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "vector_inventory_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "oos_validation_exposure_head_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "oos_episode_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stage_artifacts": { "type": "object", "additionalProperties": false, "properties": { "genetic": { "$ref": "#/$defs/hash" }, "execution_fills": { "$ref": "#/$defs/hash" }, "selected_trades": { "$ref": "#/$defs/hash" }, "stresses": { "$ref": "#/$defs/hash" }, "portfolio": { "$ref": "#/$defs/hash" }, "final_oos_artifact": { "$ref": "#/$defs/hash" }, "final_oos_vector_inventory": { "$ref": "#/$defs/hash" } } },
    "stage_artifact_refs": { "type": "object", "additionalProperties": false, "properties": { "genetic": { "$ref": "#/$defs/stageArtifactRef" }, "execution_fills": { "$ref": "#/$defs/stageArtifactRef" }, "selected_trades": { "$ref": "#/$defs/stageArtifactRef" }, "stresses": { "$ref": "#/$defs/stageArtifactRef" }, "portfolio": { "$ref": "#/$defs/stageArtifactRef" }, "final_oos_artifact": { "$ref": "#/$defs/oosArtifactRef" }, "final_oos_vector_inventory": { "$ref": "#/$defs/oosVectorRef" } } },
    "decision": { "enum": ["REJECTED", "SHADOW", "CANDIDATE_REVIEW"] },
    "gate_status": {
      "type": "object",
      "required": ["wfo", "stress", "portfolio", "all_required_stages"],
      "properties": { "wfo": { "type": "boolean" }, "stress": { "type": "boolean" }, "portfolio": { "type": "boolean" }, "all_required_stages": { "type": "boolean" } },
      "additionalProperties": false
    },
    "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    { "if": { "properties": { "decision": { "enum": ["SHADOW", "CANDIDATE_REVIEW"] } } }, "then": { "properties": { "gate_status": { "properties": { "all_required_stages": { "const": true } } } } } },
    {
      "if": { "properties": { "provenance": { "const": "AUTHORITATIVE_RECOMPUTED" }, "decision": { "enum": ["SHADOW", "CANDIDATE_REVIEW"] } } },
      "then": {
        "required": ["execution_fills_sha256", "selected_trades_sha256", "stresses_sha256", "portfolio_sha256", "oos_artifact_sha256", "vector_inventory_sha256", "oos_validation_exposure_head_sha256", "oos_episode_ids", "stage_artifacts", "stage_artifact_refs"],
        "properties": {
          "stage_artifacts": { "required": ["genetic", "execution_fills", "selected_trades", "stresses", "portfolio", "final_oos_artifact", "final_oos_vector_inventory"] },
          "stage_artifact_refs": { "required": ["genetic", "execution_fills", "selected_trades", "stresses", "portfolio", "final_oos_artifact", "final_oos_vector_inventory"] }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stageArtifactRef": {
      "type": "object",
      "required": ["schema", "version", "path", "content_sha256", "byte_sha256", "bytes"],
      "properties": {
        "schema": { "const": "strategy-v5-authoritative-stage-artifact/1" },
        "version": { "const": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" },
        "byte_sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "stageArtifactRefBase": {
      "type": "object",
      "required": ["schema", "version", "path", "content_sha256", "byte_sha256", "bytes"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "version": { "const": 1 },
        "path": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" },
        "byte_sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "oosArtifactRef": {
      "allOf": [
        { "$ref": "#/$defs/stageArtifactRefBase" },
        { "properties": { "schema": { "const": "strategy-v5-statistical-input/1" } } }
      ]
    },
    "oosVectorRef": {
      "allOf": [
        { "$ref": "#/$defs/stageArtifactRefBase" },
        { "properties": { "schema": { "const": "strategy-v5-statistical-vector-inventory/1" } } }
      ]
    },
    "candidateMetric": {
      "type": "object",
      "required": ["candidate_id", "behavior_sha256", "signal_intent", "trades", "metrics", "stresses", "portfolio"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "fold_id": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "finalist": { "type": "boolean" },
        "evidence_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE"] },
        "metric_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE"] },
        "weighting": { "type": "string", "minLength": 1 },
        "scope_episode_ids_sha256": { "$ref": "#/$defs/hash" },
        "scope_episode_count": { "type": "integer", "minimum": 0 },
        "trade_scope": { "type": "string", "minLength": 1 },
        "evaluation_attempt_sha256": { "$ref": "#/$defs/hash" },
        "evaluation_context_sha256": { "$ref": "#/$defs/hash" },
        "seed": { "type": ["integer", "null"] },
        "generation": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "operator": { "type": ["string", "null"] },
        "chromosome": { "type": "object" },
        "behavior_sha256": { "$ref": "#/$defs/hash" },
        "signal_intent": { "type": "array", "items": { "type": "object" } },
        "trades": { "type": "array", "items": { "type": "object" } },
        "metrics": { "type": "object", "required": ["expectancy_r"], "properties": { "expectancy_r": { "type": "number" }, "episode_returns": { "type": ["array", "object"] }, "episode_returns_sha256": { "$ref": "#/$defs/hash" } }, "anyOf": [{ "required": ["episode_returns"] }, { "required": ["episode_returns_sha256"] }], "additionalProperties": true },
        "stresses": { "type": "object" },
        "portfolio": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
