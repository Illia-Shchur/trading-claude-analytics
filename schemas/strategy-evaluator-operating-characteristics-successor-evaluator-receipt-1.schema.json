    "result_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "economic_semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string"},
    "executor_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metrics": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
