{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-authoritative-data-plan/1",
  "type": "object",
  "required": ["schema", "version", "status", "as_of", "window", "assets", "series", "root_reference", "raw_storage", "conversion", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-authoritative-data-plan/1" },
    "version": { "const": 1 },
    "status": { "const": "PLAN_ONLY" },
    "as_of": { "type": "string", "format": "date-time" },
    "window": { "type": "object", "required": ["years", "start_at", "end_at", "completed_through_at"], "properties": { "years": { "const": 5 }, "start_at": { "type": "string", "format": "date-time" }, "end_at": { "type": "string", "format": "date-time" }, "completed_through_at": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
    "assets": { "type": "array", "const": ["aave", "ada", "bnb", "btc", "eth", "link", "sol", "xrp"] },
    "dated_futures_catalog_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "dated_futures_catalog_status": { "type": "string" },
    "timeframe_requirements_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/series" } },
    "root_reference": { "type": "string", "pattern": "^[^/].*" },
    "raw_storage": { "type": "object", "required": ["format", "storage_role", "authoritative", "policy"], "properties": { "format": { "const": "JSONL" }, "storage_role": { "const": "STAGING" }, "authoritative": { "const": false }, "policy": { "const": "JSONL_STAGING_ONLY_NEVER_MISLABELLED_AS_PARQUET" } }, "additionalProperties": false },
    "conversion": { "type": "object", "required": ["status", "required_format", "dependency", "threads", "promotion"], "properties": { "status": { "const": "AVAILABLE" }, "required_format": { "const": "PARQUET" }, "dependency": { "const": "@duckdb/node-api@1.5.5-r.4" }, "threads": { "const": 1 }, "promotion": { "const": "REQUIRES_VERIFIED_BYTES_ROWS_SCHEMA_AND_PARTITION_MANIFEST" } }, "additionalProperties": false },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "series": {
      "type": "object",
      "required": ["asset", "venue", "instrument", "symbol", "interval", "series_type", "series_role", "trade_scope", "start_at", "end_at", "availability_cutoff_at", "required", "completed_bars_only", "require_availability_time"],
      "properties": {
        "asset": { "enum": ["btc", "eth", "sol", "bnb", "xrp", "ada", "link", "aave"] },
        "venue": { "const": "BINANCE" },
        "instrument": { "enum": ["BINANCE_SPOT", "BINANCE_USDM_PERPETUAL", "BINANCE_USDM_PERPETUAL_MARK", "BINANCE_USDM_DATED_FUTURE"] },
        "symbol": { "type": "string" },
        "interval": { "enum": ["5m", "1h", "4h", "1d", "event"] },
        "series_type": { "enum": ["signal_bars", "funding_events", "mark_bars", "metrics_events"] },
        "series_role": { "enum": ["PRICE", "FUNDING", "MARK", "METRICS"] },
        "trade_scope": { "enum": ["TRADEABLE_CRYPTO", "CONTEXT_ONLY"] },
        "start_at": { "type": "string", "format": "date-time" },
        "end_at": { "type": "string", "format": "date-time" },
        "availability_cutoff_at": { "type": "string", "format": "date-time" },
        "required": { "type": "boolean" },
        "completed_bars_only": { "type": "boolean" },
        "require_availability_time": { "type": "boolean" },
        "event_driven": { "type": "boolean" },
        "event_sequence_mode": { "type": "boolean" },
        "metric_required_fields": { "type": "array", "uniqueItems": true, "items": { "enum": ["open_interest", "open_interest_value", "top_trader_account_long_short_ratio", "top_trader_position_long_short_ratio", "global_long_short_ratio", "taker_buy_sell_volume_ratio"] } },
        "metric_minimum_field_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "expected_step_ms": { "type": ["integer", "null"], "minimum": 60000 },
        "expected_event_count": { "type": ["integer", "null"], "minimum": 0 },
        "slot_tolerance_ms": { "type": "integer", "minimum": 0 },
        "cadence_segments": { "type": "array", "items": { "$ref": "#/$defs/cadenceSegment" } },
        "expiry": { "type": ["string", "null"] },
        "expiry_observed_date_utc": { "type": ["string", "null"] },
        "expiry_binding_status": { "type": "string" },
        "tradeable": { "type": "boolean" },
        "fee_schedule_status": { "type": "string" },
        "contract_specification_status": { "type": "string" },
        "funding_status": { "type": "string" },
        "margin_status": { "type": "string" },
        "liquidation_status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cadenceSegment": { "type": "object", "required": ["effective_from", "effective_to", "cadence_ms", "origin_at", "discovery"], "properties": { "effective_from": { "type": "string", "format": "date-time" }, "effective_to": { "type": "string", "format": "date-time" }, "cadence_ms": { "type": "integer", "enum": [7200000, 14400000, 28800000] }, "origin_at": { "type": "string", "format": "date-time" }, "discovery": { "const": "OBSERVED_EVENT_GAPS" } }, "additionalProperties": false }
  }
}
