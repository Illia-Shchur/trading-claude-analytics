{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-data-manifest/3",
  "type": "object",
  "required": ["schema", "version", "status", "as_of", "window", "assets", "required_instruments", "optional_instruments", "series", "source", "raw_data_policy", "coverage", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-data-manifest/3"}, "version": {"const": 1}, "status": {"enum": ["PLAN_ONLY", "ACQUIRED"]}, "as_of": {"type": "string"}, "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "window": {"type": "object", "required": ["years", "start_at", "end_at", "completed_through_at"], "additionalProperties": false, "properties": {"years": {"const": 5}, "start_at": {"type": "string"}, "end_at": {"type": "string"}, "completed_through_at": {"type": "string"}}},
    "assets": {"type": "array", "minItems": 8, "items": {"type": "string"}}, "required_instruments": {"type": "array", "minItems": 2}, "optional_instruments": {"type": "array"},
    "series": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["asset", "venue", "instrument", "interval", "series_type", "expected_step_ms", "expected_event_count", "signal_timeframe", "execution_timeframe", "start_at", "end_at", "availability_cutoff_at", "completed_bars_only", "require_availability_time", "fee_schedule", "contract_specification", "required"], "properties": {"asset": {"type": "string"}, "venue": {"type": "string"}, "instrument": {"type": "string"}, "interval": {"type": "string"}, "series_type": {"enum": ["signal_bars", "funding_events"]}, "expected_step_ms": {"type": "integer", "minimum": 1}, "expected_event_count": {"type": "integer", "minimum": 1}, "signal_timeframe": {"type": "string"}, "execution_timeframe": {"type": "string"}, "start_at": {"type": "string"}, "end_at": {"type": "string"}, "availability_cutoff_at": {"type": "string"}, "completed_bars_only": {"type": "boolean"}, "require_availability_time": {"const": true}, "fee_schedule": {"type": "string"}, "contract_specification": {"type": "string"}, "funding": {"type": "string"}, "expiry": {"type": "string"}, "margin": {"type": "string"}, "liquidation": {"type": "string"}, "required": {"type": "boolean"}}, "additionalProperties": false, "allOf": [{"if": {"properties": {"series_type": {"const": "signal_bars"}}}, "then": {"properties": {"completed_bars_only": {"const": true}}}}, {"if": {"properties": {"series_type": {"const": "funding_events"}}}, "then": {"properties": {"completed_bars_only": {"const": false}}}}]}},
    "hydration": {"type": "object", "required": ["status", "execution_timeframe", "requires_frozen_envelope"], "properties": {"status": {"enum": ["NOT_CAPTURED", "ACQUIRED"]}, "execution_timeframe": {"const": "1m"}, "source": {"const": "opportunity-envelope"}, "maximum_lifecycle_days": {"type": "number", "exclusiveMinimum": 0}, "requires_frozen_envelope": {"const": true}}, "additionalProperties": false},
    "source": {"type": "object"}, "raw_data_policy": {"type": "string"}, "coverage": {"type": "object"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
