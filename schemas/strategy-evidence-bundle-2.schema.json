{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-evidence-bundle/2",
  "type": "object",
  "required": ["schema", "bundle_id", "evidence_phase", "experiment_sha256", "precommit_sha256", "definition_sha256", "candidate_set_sha256", "data_manifest_sha256", "feature_set_sha256", "label_set_sha256", "executor_sha256", "acceptance_contract_sha256", "portfolio_policy_sha256", "metrics", "trades", "metrics_sha256", "trades_sha256", "candidate_accounting", "candidate_accounting_sha256", "decision", "decisions", "provenance", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-evidence-bundle/2" }, "bundle_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidence_phase": { "enum": ["DEVELOPMENT", "WALK_FORWARD_OOS", "EXPOSED_CONFIRMATION", "CI_ATTESTED_CONFIRMATION", "PROSPECTIVE_LIVE"] },
    "experiment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "precommit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "candidate_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "data_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "feature_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "label_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "executor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "container_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "acceptance_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "portfolio_policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "metrics": { "type": "array" }, "trades": { "type": "array" }, "stress": { "type": ["object", "null"] }, "portfolio": { "type": ["object", "null"] }, "wfo": { "type": ["object", "null"] }, "metrics_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "trades_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "candidate_accounting": { "type": ["object", "null"] }, "candidate_accounting_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "acceptance_basis": { "type": ["string", "null"] },
    "stress_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "portfolio_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "wfo_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "decision": { "$ref": "#/$defs/decision" }, "decisions": { "type": "object", "required": ["per_asset", "portfolio"], "properties": { "per_asset": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } }, "portfolio": { "$ref": "#/$defs/decision" } }, "additionalProperties": false }, "provenance": { "enum": ["AUTHORITATIVE_RECOMPUTED", "CI_ATTESTED", "EXTERNAL_EXPOSED"] }, "acceptance_result": { "type": "object" }, "acceptance_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "prospective_monitoring": { "type": ["object", "null"] }, "prospective_monitoring_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }, "additionalProperties": false,
  "$defs": { "decision": { "type": "object", "required": ["status"], "properties": { "asset": { "type": "string" }, "candidate_id": { "type": ["string", "null"] }, "status": { "enum": ["REJECTED", "SHADOW", "CANDIDATE_REVIEW"] }, "reasons": { "type": "array", "items": { "type": "string" } }, "acceptance_result": { "type": "object" } }, "additionalProperties": false } }
}
