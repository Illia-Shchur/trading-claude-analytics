{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-evidence/5",
  "type": "object",
  "required": ["schema", "version", "run_sha256", "provenance", "pipeline", "lineage", "manifest_sha256", "candidate_metrics", "stresses", "portfolio", "wfo", "decision", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-research-evidence/5" },
    "version": { "const": 1 },
    "run_sha256": { "$ref": "#/$defs/hash" },
    "provenance": { "enum": ["AUTHORITATIVE_RECOMPUTED", "AUTHORITATIVE_BLOCKED"] },
    "strategy_family_id": { "type": ["string", "null"], "minLength": 1 },
    "strategy_version": { "type": ["string", "null"], "minLength": 1 },
    "experiment_id": { "type": ["string", "null"], "minLength": 1 },
    "evidence_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE", null] },
    "asset_set": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "pipeline": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "enum": ["features", "signal_intent", "labels", "execution_fills", "trades", "metrics", "stresses", "portfolio", "wfo"] } },
    "lineage": {
      "type": "object",
      "required": ["manifest_sha256", "feature_rows_sha256", "label_rows_sha256", "execution_rows_sha256", "mark_rows_sha256"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/hash" },
        "envelope_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_domain_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_hydration_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "opportunity_partition_root_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "candidate_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "feature_rows_sha256": { "$ref": "#/$defs/hash" },
        "label_rows_sha256": { "$ref": "#/$defs/hash" },
        "execution_rows_sha256": { "$ref": "#/$defs/hash" },
        "mark_rows_sha256": { "$ref": "#/$defs/hash" },
        "wfo_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "manifest_sha256": { "$ref": "#/$defs/hash" },
    "candidate_metrics": { "type": "array", "items": { "$ref": "#/$defs/candidateMetric" } },
    "stresses": { "$ref": "#/$defs/stage" },
    "portfolio": { "$ref": "#/$defs/portfolioStage" },
    "wfo": { "type": "object", "required": ["status", "pass", "fail_closed"], "properties": { "status": { "type": "string" }, "pass": { "type": "boolean" }, "artifact": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "fail_closed": { "type": "boolean" } }, "additionalProperties": false },
    "decision": { "enum": ["REJECTED", "SHADOW", "CANDIDATE_REVIEW"] },
    "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidateMetric": {
      "type": "object",
      "required": ["candidate_id", "behavior_sha256", "metrics"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "fold_id": { "type": "string", "minLength": 1 },
        "selected": { "type": "boolean" },
        "finalist": { "type": "boolean" },
        "evidence_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE"] },
        "metric_phase": { "enum": ["DEVELOPMENT", "INNER", "OOS", "EXPOSED", "SEALED", "PROSPECTIVE"] },
        "weighting": { "type": "string", "minLength": 1 },
        "scope_episode_ids_sha256": { "$ref": "#/$defs/hash" },
        "scope_episode_count": { "type": "integer", "minimum": 0 },
        "trade_scope": { "type": "string", "minLength": 1 },
        "evaluation_attempt_sha256": { "$ref": "#/$defs/hash" },
        "evaluation_context_sha256": { "$ref": "#/$defs/hash" },
        "seed": { "type": ["integer", "null"] },
        "generation": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "operator": { "type": ["string", "null"] },
        "chromosome": { "type": "object" },
        "behavior_sha256": { "$ref": "#/$defs/hash" },
        "signal_intent": { "type": "array", "items": { "type": "object" } },
        "trades": { "type": "array", "items": { "type": "object" } },
        "metrics": { "type": "object" },
        "stresses": { "type": "object" },
        "portfolio": { "type": "object" }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["status", "pass", "artifacts"],
      "properties": { "status": { "type": "string" }, "pass": { "type": "boolean" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/hash" } } },
      "additionalProperties": false
    },
    "portfolioStage": {
      "type": "object",
      "required": ["status", "pass", "marks_bound", "funding_attribution_only", "artifacts"],
      "properties": { "status": { "type": "string" }, "pass": { "type": "boolean" }, "marks_bound": { "type": "boolean" }, "funding_attribution_only": { "type": "boolean" }, "artifacts": { "type": "array", "items": { "$ref": "#/$defs/hash" } } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
