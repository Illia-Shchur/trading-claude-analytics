{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-execution-partition-set/1",
  "type": "object",
  "required": ["schema", "version", "status", "fixture_only", "provenance", "partition_count", "partition_bytes_root_sha256", "partitions", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-execution-partition-set/1" },
    "version": { "const": 1 },
    "status": { "const": "FROZEN" },
    "fixture_only": { "type": "boolean" },
    "provenance": { "type": "string", "minLength": 1 },
    "partition_count": { "type": "integer", "minimum": 1 },
    "partition_bytes_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "partitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partition_id", "sha256", "bytes", "row_count", "min_event_time", "max_event_time", "format", "asset", "instrument", "symbol"],
        "properties": {
          "partition_id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "row_count": { "type": "integer", "minimum": 1 },
          "min_event_time": { "type": "string", "format": "date-time" },
          "max_event_time": { "type": "string", "format": "date-time" },
          "format": { "const": "JSONL_1M" },
          "asset": { "type": ["string", "null"] },
          "instrument": { "type": ["string", "null"] },
          "symbol": { "type": ["string", "null"] },
          "path": { "type": "string", "minLength": 1 },
          "body": {},
          "rows": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
