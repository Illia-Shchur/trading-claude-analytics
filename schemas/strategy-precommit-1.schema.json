{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-precommit/1",
  "type": "object",
  "required": ["schema", "precommit_id", "created_at", "stage", "phenomenon", "economic_behavioral_mechanism", "participants", "persistence", "crowding_decay", "direction", "expression", "holding_horizon", "expected_signal_frequency", "expected_win_rate", "payoff", "regimes", "failure_invalidation_mechanism", "required_inputs", "falsifier", "tradable_instrument_contract", "non_crypto_context_only", "independence_replication_groups", "role_of_composite_score"],
  "properties": {
    "schema": { "const": "strategy-precommit/1" },
    "precommit_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "created_at": { "type": "string", "format": "date-time" },
    "stage": { "const": "CORE_PREMISE" },
    "phenomenon": { "type": "string", "minLength": 1 },
    "economic_behavioral_mechanism": { "type": "string", "minLength": 1 },
    "participants": { "type": "object", "required": ["forced_actor", "edge_provider", "edge_consumer"] },
    "persistence": { "type": "string", "minLength": 1 },
    "crowding_decay": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "minLength": 1 },
    "expression": { "type": "string", "minLength": 1 },
    "holding_horizon": { "$ref": "#/$defs/rangeWithUnit" },
    "expected_signal_frequency": { "$ref": "#/$defs/rangeWithUnit" },
    "expected_win_rate": { "$ref": "#/$defs/range" },
    "payoff": { "type": "object", "required": ["average_win_r", "average_loss_r", "qualitative_shape"] },
    "regimes": { "type": "object", "required": ["expected_to_work", "expected_to_fail"] },
    "failure_invalidation_mechanism": { "type": "string", "minLength": 1 },
    "required_inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/input" } },
    "falsifier": { "type": "object", "required": ["test", "null", "rejection_thresholds"] },
    "tradable_instrument_contract": {
      "type": "object",
      "required": ["universe", "instruments"],
      "properties": { "universe": { "const": "CRYPTO_ONLY" }, "instruments": { "type": "array", "minItems": 1 } }
    },
    "non_crypto_context_only": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["input_id", "asset", "asset_class", "context_only", "tradable"],
        "properties": { "input_id": { "type": "string" }, "asset": { "type": "string" }, "asset_class": { "enum": ["equity", "etf", "rate", "rates", "fx", "currency", "commodity", "index", "bond", "cash"] }, "context_only": { "const": true }, "tradable": { "const": false } }
      }
    },
    "independence_replication_groups": { "type": "array", "minItems": 1 },
    "role_of_composite_score": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "FROZEN", "REJECTED"] },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "range": { "type": "object", "required": ["min", "max"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } } },
    "rangeWithUnit": { "allOf": [{ "$ref": "#/$defs/range" }, { "type": "object", "required": ["unit"] }] },
    "input": {
      "type": "object",
      "required": ["input_id", "availability", "point_in_time", "evidence_family", "role"],
      "properties": {
        "input_id": { "type": "string", "minLength": 1 },
        "availability": { "type": "object" },
        "point_in_time": { "type": "object", "required": ["status"] },
        "evidence_family": { "type": "string", "minLength": 1 },
        "role": { "enum": ["SETUP", "CORE", "MECHANISM", "CONTEXT", "SCORE"] }
      }
    }
  },
  "additionalProperties": true
}
