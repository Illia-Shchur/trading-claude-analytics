{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-predictor-registry/1",
  "type": "object",
  "required": ["schema", "version", "status", "predictors", "content_sha256"],
  "properties": { "schema": { "const": "strategy-v5-predictor-registry/1" }, "version": { "const": 1 }, "status": { "const": "FROZEN" }, "predictors": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "scalar_type", "source_field", "source_family", "lookback_ms", "availability_derivation", "code_sha256", "config_sha256", "pit_role"], "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" }, "scalar_type": { "enum": ["number", "integer", "boolean"] }, "source_field": { "type": "string" }, "source_family": { "type": "string" }, "source_timeframe": { "enum": ["1h", "4h", "1d", "event"] }, "lookback_ms": { "type": "integer", "minimum": 0 }, "availability_derivation": { "type": "string" }, "code_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pit_role": { "const": "PREDICTOR" }, "recipe": { "$ref": "#/$defs/recipe" }, "trade_scope": { "enum": ["TRADEABLE_CRYPTO", "CONTEXT_ONLY"] } }, "additionalProperties": false } }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "series_reference": { "type": "object", "additionalProperties": false, "required": ["asset", "venue", "instrument", "symbol"], "properties": { "asset": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$" }, "venue": { "type": "string", "minLength": 1 }, "instrument": { "type": "string", "minLength": 1 }, "symbol": { "type": "string", "minLength": 1 }, "series_id": { "type": "string", "minLength": 1 }, "series_type": { "type": "string", "minLength": 1 } } },
    "recipe": { "type": "object", "additionalProperties": false, "required": ["module", "kind", "source_field", "source_series", "lookback_bars", "min_history", "window_policy", "availability_policy", "series_scope", "current_observation_policy", "excluded_window_bars", "module_code_sha256", "module_config_sha256"], "properties": { "module": { "const": "builtin-pit-transform/1" }, "kind": { "enum": ["FIELD", "RETURN", "SMA", "STDDEV_ZSCORE", "RSI"] }, "source_field": { "type": "string", "minLength": 1 }, "source_series": { "type": "string", "minLength": 1 }, "lookback_bars": { "type": "integer", "minimum": 0 }, "min_history": { "type": "integer", "minimum": 1 }, "window_policy": { "const": "COMPLETED_OBSERVATIONS_ONLY" }, "availability_policy": { "const": "MAX_INPUT_AVAILABILITY" }, "series_scope": { "enum": ["SAME_ASSET_VENUE_INSTRUMENT_SYMBOL", "EXPLICIT_REFERENCE_SERIES"] }, "reference_series": { "$ref": "#/$defs/series_reference" }, "asof_policy": { "const": "LATEST_AVAILABLE_NOT_AFTER_DECISION" }, "max_staleness_ms": { "type": "integer", "minimum": 1 }, "lag_bars": { "type": "integer", "minimum": 0 }, "resample_policy": { "enum": ["EXACT_EVENT", "LAST_AVAILABLE", "BAR_CLOSE"] }, "context_only": { "type": "boolean" }, "rsi_method": { "const": "WILDER_RSI" }, "current_observation_policy": { "enum": ["INCLUDE_CURRENT_COMPLETED", "EXCLUDE_CURRENT_COMPLETED"] }, "excluded_window_bars": { "type": "integer", "minimum": 0 }, "module_code_sha256": { "$ref": "#/$defs/hash" }, "module_config_sha256": { "$ref": "#/$defs/hash" } }, "allOf": [{ "if": { "properties": { "series_scope": { "const": "EXPLICIT_REFERENCE_SERIES" } } }, "then": { "required": ["reference_series", "asof_policy", "max_staleness_ms", "lag_bars", "resample_policy", "context_only"] } }, { "if": { "properties": { "kind": { "const": "RSI" } } }, "then": { "required": ["rsi_method"] } }] }
  }
}
