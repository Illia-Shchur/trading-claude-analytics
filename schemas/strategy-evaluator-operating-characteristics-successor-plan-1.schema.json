{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-evaluator-operating-characteristics-successor-plan/1",
  "type": "object",
  "required": ["schema", "version", "stage_scope", "evidence_phase", "decision", "development_exposure", "promotion_eligible", "activation_authorized", "outcomes_opened", "binding_fixed_evaluator", "predecessor_diagnosis_sha256", "baseline_sha256", "control_spec_sha256", "experiment_sha256", "lineage_inventory_sha256", "control_design_sha256", "executor_source_sha256", "executor_identity_sha256", "cells", "cell_count", "replications", "episodes_per_replication", "cluster_count", "paired_cluster_count", "lifecycle_series_per_replication", "horizon_minutes", "resource_budget", "resource_preflight", "acceptance", "stopping", "incomplete_run_policy", "frozen_before_outcomes", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-evaluator-operating-characteristics-successor-plan/1"},
    "version": {"const": 1},
    "stage_scope": {"const": "FIXED_BASELINE_OPERATING_CHARACTERISTICS_SUCCESSOR"},
    "evidence_phase": {"const": "DEVELOPMENT"},
    "decision": {"const": "DIAGNOSTIC_ONLY"},
    "development_exposure": {"const": true},
    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "outcomes_opened": {"const": false},
    "binding_fixed_evaluator": {"const": "StrategyFixedBaselineV5+TradeLifecycleV5+StrategyResearchImprovementV1.disposition"},
    "predecessor_diagnosis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "control_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lineage_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "control_design_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cells": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["scenario", "effect_size", "seeds", "prefix_seeds"], "properties": {"scenario": {"type": "string"}, "effect_size": {"type": "number"}, "seeds": {"type": "array", "items": {"type": "integer"}}, "prefix_seeds": {"type": "array", "items": {"type": "integer"}}}, "additionalProperties": true}},
    "cell_count": {"const": 4},
    "replications": {"const": 75},
    "episodes_per_replication": {"const": 450},
    "cluster_count": {"const": 288},
    "paired_cluster_count": {"const": 162},
    "lifecycle_series_per_replication": {"type": "integer", "minimum": 1},
    "horizon_minutes": {"type": "integer", "minimum": 1},
    "resource_budget": {"type": "object", "required": ["max_wall_minutes", "max_rss_bytes", "max_disk_bytes", "expected_generated_minute_bars"], "properties": {"max_wall_minutes": {"type": "integer", "minimum": 1}, "max_rss_bytes": {"type": "integer", "minimum": 1}, "max_disk_bytes": {"type": "integer", "minimum": 1}, "expected_generated_minute_bars": {"type": "integer", "minimum": 1}}, "additionalProperties": true},
    "resource_preflight": {"type": "object", "required": ["replications", "episodes_per_replication"], "properties": {"replications": {"const": 2}, "episodes_per_replication": {"const": 10}}, "additionalProperties": true},
    "acceptance": {"type": "object", "required": ["preserve_v004_standards", "confidence_interval", "false_positive_upper_bound", "power_lower_bound"], "properties": {"preserve_v004_standards": {"const": true}, "confidence_interval": {"const": "WILSON_95_PERCENT"}, "false_positive_upper_bound": {"const": 0.1}, "power_lower_bound": {"const": 0.8}}, "additionalProperties": true},
    "stopping": {"type": "object", "required": ["fixed_no_optional_stopping"], "properties": {"fixed_no_optional_stopping": {"const": true}}, "additionalProperties": true},
    "incomplete_run_policy": {"type": "object", "required": ["count_in_denominator", "retain_all_attempts"], "properties": {"count_in_denominator": {"const": true}, "retain_all_attempts": {"const": true}}, "additionalProperties": true},
    "frozen_before_outcomes": {"const": true},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
