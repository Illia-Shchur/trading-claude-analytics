{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-metadata-receipt/1",
  "type": "object",
  "required": ["schema", "version", "kind", "status", "records", "limitations", "authoritative", "source", "source_receipt_sha256", "source_byte_sha256", "model_sha256", "precommit_sha256", "provenance_mode", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-metadata-receipt/1" },
    "version": { "const": 1 },
    "kind": { "enum": ["FEE_SCHEDULE", "FUNDING_IDENTITY", "CONTRACT_SPEC", "EXPIRY", "MARGIN", "LIQUIDATION", "EXECUTION_MODEL"] },
    "status": { "enum": ["PUBLIC_OBSERVED", "USER_BOUND", "CONSERVATIVE_MODEL", "UNAVAILABLE"] },
    "plan_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "source": { "type": ["object", "null"], "minProperties": 1, "properties": { "provider": { "type": "string" }, "kind": { "type": "string" }, "content_sha256": { "$ref": "#/$defs/hash" }, "sha256": { "$ref": "#/$defs/hash" }, "byte_sha256": { "type": ["string", "array"], "items": { "$ref": "#/$defs/hash" } }, "source_byte_sha256": { "type": ["string", "array"], "items": { "$ref": "#/$defs/hash" } }, "path": { "type": "string" }, "endpoint": { "type": "string" }, "raw_receipts": { "type": "array", "items": { "$ref": "#/$defs/rawReceipt" } } }, "additionalProperties": false },
    "source_receipt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "source_root_reference": { "type": ["string", "null"] },
    "source_byte_sha256": { "type": ["string", "array", "null"], "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "source_receipts": { "type": "array", "items": { "$ref": "#/$defs/sourceReceiptSummary" } },
    "model_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "model_path": { "type": ["string", "null"] },
    "model_code_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "model_code_path": { "type": ["string", "null"] },
    "model_config_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "model_config_path": { "type": ["string", "null"] },
    "precommit_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "precommit_path": { "type": ["string", "null"] },
    "provenance_mode": { "enum": ["BOUND_SOURCE", "MODEL_BOUND", "UNAVAILABLE", "FIXTURE_ONLY"] },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "coverage": { "type": ["object", "null"], "properties": { "complete": { "type": "boolean" }, "coverage_mode": { "type": "string" }, "expected_slots": { "type": ["integer", "null"] }, "observed_events": { "type": "integer" }, "missing_slots": { "type": ["array", "null"], "items": { "type": "string" } }, "slot_tolerance_ms": { "type": "integer" }, "cadence_ms": { "type": ["integer", "null"] }, "anchor_time": { "type": ["string", "null"], "format": "date-time" }, "cadence_segments": { "type": "array", "items": { "$ref": "#/$defs/cadenceSegment" } }, "source_pagination_complete": { "type": ["boolean", "null"] } }, "additionalProperties": false },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "authoritative": { "type": "boolean" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawReceipt": { "type": "object", "required": ["schema", "version", "content_sha256", "path", "byte_sha256", "bytes", "format", "storage_role", "authoritative"], "properties": { "schema": { "const": "strategy-v5-source-receipt/1" }, "version": { "const": 1 }, "content_sha256": { "$ref": "#/$defs/hash" }, "path": { "type": "string" }, "byte_sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 }, "format": { "const": "RAW_BYTES" }, "storage_role": { "const": "RAW_IGNORED" }, "authoritative": { "const": false }, "source": { "type": ["string", "null"] }, "request": { "type": ["object", "null"], "additionalProperties": false, "properties": { "endpoint": { "type": "string" }, "symbol": { "type": "string" }, "interval": { "type": "string" }, "response_sha256": { "$ref": "#/$defs/hash" }, "start_at": { "type": "string", "format": "date-time" }, "end_at": { "type": "string", "format": "date-time" } } } }, "additionalProperties": false },
    "sourceReceiptSummary": { "type": "object", "required": ["path", "sha256", "schema", "status"], "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" }, "content_sha256": { "$ref": "#/$defs/hash" }, "byte_sha256": { "type": ["string", "array", "null"], "items": { "$ref": "#/$defs/hash" } }, "raw_receipts": { "type": "array", "items": { "$ref": "#/$defs/rawReceipt" } }, "schema": { "const": "strategy-v5-source-receipt/1" }, "status": { "type": "string" } }, "additionalProperties": false },
    "record": { "type": "object", "required": ["asset", "instrument", "effective_from", "effective_to", "availability_time"], "properties": {
      "settlement_price": { "type": "number", "exclusiveMinimum": 0 },
      "step_size": { "type": "number", "exclusiveMinimum": 0 }, "lot_step": { "type": "number", "exclusiveMinimum": 0 }, "min_qty": { "type": "number", "exclusiveMinimum": 0 }, "max_qty": { "type": "number", "exclusiveMinimum": 0 }, "min_notional": { "type": "number", "exclusiveMinimum": 0 }, "max_notional": { "type": "number", "exclusiveMinimum": 0 },
      "asset": { "type": "string" }, "venue": { "type": "string" }, "symbol": { "type": "string" }, "instrument": { "type": "string" }, "effective_from": { "type": "string", "format": "date-time" }, "effective_to": { "type": "string", "format": "date-time" }, "availability_time": { "type": "string", "format": "date-time" },
      "taker_fee_rate": { "type": "number" }, "taker_rate": { "type": "number" }, "maker_fee_rate": { "type": "number" }, "funding_rate": { "type": "number" }, "rate": { "type": "number" }, "event_id": { "type": "string" }, "raw_event_time": { "type": ["string", "number"] }, "event_time": { "type": ["string", "number"] }, "settlement_time": { "type": ["string", "number"] }, "settlement_slot": { "type": ["string", "null"] }, "settlement_mark": { "type": "number" }, "mark_price": { "type": "number" }, "cadence_ms": { "type": "integer" }, "funding_interval_ms": { "type": "integer" }, "contract_multiplier": { "type": "number" }, "max_leverage": { "type": "number" }, "leverage": { "type": "number" }, "expiry": { "type": ["string", "null"], "format": "date-time" }, "delivery_date": { "type": ["string", "null"] }, "maintenance_margin_ratio": { "type": "number" }, "margin_mode": { "type": "string" }, "tier_id": { "type": "string" }, "liquidation_price": { "type": "number" }, "collateral_asset": { "type": "string" }, "collateral_symbol": { "type": "string" }, "slippage_bps": { "type": "number" }, "impact_bps": { "type": "number" }, "outage_policy": { "type": "string" }, "gap_policy": { "type": "string" }, "source_receipt_sha256": { "$ref": "#/$defs/hash" }, "source_byte_sha256": { "$ref": "#/$defs/hash" }, "settlement_mark_sha256": { "$ref": "#/$defs/hash" }, "settlement_mark_event_id": { "type": "string" }, "settlement_mark_source_sha256": { "$ref": "#/$defs/hash" }, "mark_series_type": { "enum": ["FUNDING_MARK", "LIQUIDATION_MARK"] }, "funding_partition_sha256": { "$ref": "#/$defs/hash" }
    }, "additionalProperties": false },
    "cadenceSegment": { "type": "object", "required": ["effective_from", "effective_to", "cadence_ms", "origin_at", "discovery"], "properties": { "effective_from": { "type": "string", "format": "date-time" }, "effective_to": { "type": "string", "format": "date-time" }, "cadence_ms": { "type": "integer", "enum": [7200000, 14400000, 28800000] }, "origin_at": { "type": "string", "format": "date-time" }, "discovery": { "const": "OBSERVED_EVENT_GAPS" } }, "additionalProperties": false }
  }
}
