    "development_only": {"const": true},
    "outcome_blind": {"const": true},
    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "predecessor_control_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
