{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-readiness-evidence-manifest/1",
  "type": "object",
  "required": ["schema", "version", "status", "entries", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-readiness-evidence-manifest/1"},
    "version": {"const": 1},
    "status": {"const": "FROZEN"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "schema", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "dependencies": {"type": "array"}
        },
        "additionalProperties": false
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
