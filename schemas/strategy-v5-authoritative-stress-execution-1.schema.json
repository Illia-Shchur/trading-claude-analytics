{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-authoritative-stress-execution/1",
  "type": "object",
  "required": ["schema", "version", "status", "provenance", "source_manifest_sha256", "source_role_hashes", "source_role_identity_sha256", "execution_code_sha256", "stress_contract_sha256", "selected_candidate_id", "definition_sha256", "lineage_sha256", "scenarios", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-authoritative-stress-execution/1" },
    "version": { "const": 1 },
    "status": { "const": "COMPLETE" },
    "provenance": { "const": "AUTHORITATIVE_RECOMPUTED" },
    "source_manifest_sha256": { "$ref": "#/$defs/hash" },
    "source_role_hashes": {
      "type": "object", "additionalProperties": false, "required": ["feature", "label", "execution", "mark"],
      "properties": { "feature": { "$ref": "#/$defs/hash" }, "label": { "$ref": "#/$defs/hash" }, "execution": { "$ref": "#/$defs/hash" }, "mark": { "$ref": "#/$defs/hash" } }
    },
    "source_role_identity_sha256": { "$ref": "#/$defs/hash" },
    "execution_code_sha256": { "$ref": "#/$defs/hash" },
    "stress_contract_sha256": { "$ref": "#/$defs/hash" },
    "selected_candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "definition_sha256": { "$ref": "#/$defs/hash" },
    "lineage_sha256": { "$ref": "#/$defs/hash" },
    "scenarios": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/scenario" } },
    "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "selected_candidate_id", "definition_sha256", "source_role_hashes", "source_role_identity_sha256", "execution_code_sha256", "stress_contract_sha256", "parameters_sha256", "fills", "fill_vector_sha256", "metrics", "pass", "limitations", "digest"],
      "properties": {
        "id": { "type": "string" },
        "selected_candidate_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "definition_sha256": { "$ref": "#/$defs/hash" },
        "source_role_hashes": { "$ref": "#/$defs/roleHashes" },
        "source_role_identity_sha256": { "$ref": "#/$defs/hash" },
        "execution_code_sha256": { "$ref": "#/$defs/hash" },
        "stress_contract_sha256": { "$ref": "#/$defs/hash" },
        "parameters_sha256": { "$ref": "#/$defs/hash" },
        "fills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fill" } },
        "fill_vector_sha256": { "$ref": "#/$defs/hash" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "pass": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "digest": { "$ref": "#/$defs/hash" }
      }
    },
    "roleHashes": {
      "type": "object", "additionalProperties": false, "required": ["feature", "label", "execution", "mark"],
      "properties": { "feature": { "$ref": "#/$defs/hash" }, "label": { "$ref": "#/$defs/hash" }, "execution": { "$ref": "#/$defs/hash" }, "mark": { "$ref": "#/$defs/hash" } }
    },
    "fill": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_id", "asset", "traded", "net_r", "physical_coverage", "outcome", "outcome_sha256", "reason"],
      "properties": {
        "episode_id": { "type": "string" }, "asset": { "type": "string" }, "traded": { "type": "boolean" }, "net_r": { "type": "number" }, "physical_coverage": { "type": "boolean" },
        "outcome": { "anyOf": [{ "type": "null" }, { "type": "object" }] }, "outcome_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "reason": { "type": ["string", "null"] }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["episode_count", "traded_count", "expectancy_r", "bootstrap_p20_r", "p20_r", "profit_factor", "max_drawdown_r", "cost_r", "coverage_fraction", "minimum_observations", "minimum_expectancy_r", "minimum_p20_r", "minimum_profit_factor", "maximum_drawdown_r", "maximum_cost_r", "minimum_coverage_fraction", "survival_condition", "resampling_iterations", "resampling_seed", "resampling_block_length", "pass"],
      "properties": {
        "episode_count": { "type": "integer", "minimum": 1 }, "traded_count": { "type": "integer", "minimum": 0 },
        "expectancy_r": { "type": ["number", "null"] }, "bootstrap_p20_r": { "type": ["number", "null"] }, "p20_r": { "type": ["number", "null"] }, "profit_factor": { "type": ["number", "null"] },
        "max_drawdown_r": { "type": "number", "minimum": 0 }, "cost_r": { "type": "number", "minimum": 0 }, "coverage_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_observations": { "type": "number", "minimum": 1 }, "minimum_expectancy_r": { "type": "number" }, "minimum_p20_r": { "type": "number" }, "minimum_profit_factor": { "type": "number", "minimum": 0 }, "maximum_drawdown_r": { "type": "number", "minimum": 0 }, "maximum_cost_r": { "type": "number", "minimum": 0 }, "minimum_coverage_fraction": { "type": "number", "minimum": 0, "maximum": 1 }, "survival_condition": { "type": "string" }, "resampling_iterations": { "type": "integer", "minimum": 1 }, "resampling_seed": { "type": "integer", "minimum": 0 }, "resampling_block_length": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "pass": { "type": "boolean" }
      }
    }
  }
}
