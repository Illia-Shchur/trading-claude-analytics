{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-experiment/3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "created_at", "stage", "evidence_phase", "precommit_sha256", "definition_sha256", "candidate_set_sha256", "data_manifest_sha256", "executor_sha256", "acceptance_contract_sha256", "acceptance_contract", "chronology", "required_assets", "portfolio_policy", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-experiment/3" }, "experiment_id": { "type": "string", "minLength": 1 }, "created_at": { "type": "string" },
    "stage": { "enum": ["CORE_PREMISE", "ENTRY_TIMING", "RISK_LIFECYCLE", "INDEPENDENT_CONTEXT", "COMPOSITE_SCORE"] },
    "predecessor_stage": { "enum": ["CORE_PREMISE", "ENTRY_TIMING", "RISK_LIFECYCLE", "INDEPENDENT_CONTEXT", null] },
    "evidence_phase": { "enum": ["DEVELOPMENT", "WALK_FORWARD_OOS", "EXPOSED_CONFIRMATION", "CI_ATTESTED_CONFIRMATION", "SEALED_CONFIRMATION", "PROSPECTIVE_LIVE"] },
    "precommit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "candidate_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "data_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parent_evidence_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "predecessor_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "feature_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "label_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "executor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "container_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "acceptance_contract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acceptance_contract": { "$ref": "#/$defs/acceptance" },
    "training_selection_policy": { "$ref": "#/$defs/training_policy" }, "training_selection_policy_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "chronology": {
      "type": "object", "additionalProperties": false, "required": ["timezone", "bar_convention", "seeds"],
      "properties": {
        "timezone": { "type": "string" }, "bar_convention": { "type": "string" }, "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer" } }, "bar_duration_ms": { "type": "number", "exclusiveMinimum": 0 }, "purge_bars": { "type": "integer", "minimum": 0 }, "embargo_bars": { "type": "integer", "minimum": 0 }, "bootstrap_iterations": { "type": "integer", "minimum": 1 },
        "frozen_selection": { "type": "boolean" }, "frozen_candidate_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "frozen_candidate_by_asset": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }, "selection_objective": { "type": "string" }, "tie_breaker": { "type": "array" }, "development_window": { "type": "object" }, "monitoring_window": { "type": "object" }, "frozen_start_time": { "type": ["string", "number"] }, "frozen_hashes": { "type": "object" },
        "folds": { "type": "array", "items": { "type": "object", "additionalProperties": false, "properties": { "fold_id": { "type": "string" }, "train_start": { "type": ["string", "number"] }, "train_end": { "type": ["string", "number"] }, "test_start": { "type": ["string", "number"] }, "test_end": { "type": ["string", "number"] }, "train": { "type": "object" }, "test": { "type": "object" }, "bar_duration_ms": { "type": "number", "exclusiveMinimum": 0 }, "purge_bars": { "type": "integer", "minimum": 0 }, "embargo_bars": { "type": "integer", "minimum": 0 }, "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
      }
    },
    "required_assets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["asset", "asset_class", "instrument"], "properties": { "asset": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "asset_class": { "const": "crypto" }, "instrument": { "type": "string" } } } },
    "portfolio_policy": { "type": "object", "additionalProperties": false, "properties": { "initial_equity": { "type": "number", "exclusiveMinimum": 0 }, "max_concurrent": { "type": "number", "minimum": 1 }, "total_concurrency": { "type": "number", "minimum": 1 }, "per_asset_concurrency": { "type": "number", "minimum": 1 }, "gross_exposure_cap": { "type": "number", "minimum": 0 }, "net_exposure_cap": { "type": "number", "minimum": 0 }, "collateral_cap": { "type": "number", "minimum": 0 }, "leverage_cap": { "type": "number", "minimum": 1 }, "advanced_risk": { "type": "boolean" }, "stress_window_bars": { "type": "integer", "minimum": 3 }, "stress_correlation_selection": { "enum": ["MAX_ABSOLUTE", "MAX_POSITIVE"] }, "max_mark_gap_ms": { "type": "number", "exclusiveMinimum": 0 }, "acceptance": { "type": "object" }, "venue_caps": { "type": "object" }, "cluster_caps": { "type": "object" }, "risk_strategy_cluster_caps": { "type": "object" } } },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    { "if": { "properties": { "evidence_phase": { "enum": ["WALK_FORWARD_OOS", "EXPOSED_CONFIRMATION", "CI_ATTESTED_CONFIRMATION", "PROSPECTIVE_LIVE"] } } }, "then": { "required": ["training_selection_policy", "training_selection_policy_sha256", "feature_set_sha256", "label_set_sha256"] } },
    { "if": { "properties": { "evidence_phase": { "const": "WALK_FORWARD_OOS" } } }, "then": { "properties": { "chronology": { "required": ["folds"] } } } },
    { "if": { "properties": { "evidence_phase": { "const": "EXPOSED_CONFIRMATION" } } }, "then": { "required": ["parent_evidence_sha256"], "properties": { "chronology": { "required": ["frozen_selection"], "anyOf": [{ "required": ["frozen_candidate_ids"] }, { "required": ["frozen_candidate_by_asset"] }] } } } }
  ],
  "$defs": {
    "training_policy": {
      "type": "object", "additionalProperties": false, "required": ["schema", "minimum_completed_trades", "minimum_expectancy_r", "objective", "tie_break", "nested_search_control", "content_sha256"],
      "properties": { "schema": { "const": "strategy-training-selection-policy/1" }, "minimum_completed_trades": { "type": "integer", "minimum": 1 }, "minimum_expectancy_r": { "type": "number" }, "objective": { "const": "expectancy_r_desc" }, "tie_break": { "const": "candidate_id_asc" }, "nested_search_control": { "const": "WFO_NESTED_SELECTION" }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "contract_id", "profile", "gates", "stress_scenarios", "content_sha256"],
      "properties": {
        "schema": { "const": "strategy-acceptance-contract/1" }, "contract_id": { "type": "string", "minLength": 1 }, "profile": { "type": "string", "minLength": 1 }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gates": { "type": "object", "additionalProperties": false, "required": ["minimum_independent_episodes", "minimum_completed_episodes", "minimum_expectancy_r", "minimum_search_adjusted_expectancy_r", "minimum_r_profit_factor", "minimum_account_profit_factor", "minimum_total_return", "minimum_bootstrap_p20_expectancy_r", "maximum_candidate_set_p_value", "maximum_drawdown_pct", "minimum_positive_years", "minimum_episodes_per_positive_year", "minimum_positive_blocks", "maximum_negative_block_expectancy_r", "minimum_doubled_cost_expectancy_r", "minimum_doubled_cost_account_profit_factor", "minimum_coverage_fraction", "maximum_undeclared_gap_bars", "minimum_wfo_oos_episodes", "minimum_wfo_positive_folds"], "properties": { "minimum_independent_episodes": { "type": "number" }, "minimum_completed_episodes": { "type": "number" }, "minimum_expectancy_r": { "type": "number" }, "minimum_search_adjusted_expectancy_r": { "type": "number" }, "minimum_r_profit_factor": { "type": "number" }, "minimum_account_profit_factor": { "type": "number" }, "minimum_total_return": { "type": "number" }, "minimum_bootstrap_p20_expectancy_r": { "type": "number" }, "maximum_candidate_set_p_value": { "type": "number" }, "maximum_drawdown_pct": { "type": "number", "minimum": 0 }, "maximum_drawdown_r": { "type": "number", "minimum": 0 }, "maximum_cost_r": { "type": "number", "minimum": 0 }, "minimum_positive_years": { "type": "number" }, "minimum_episodes_per_positive_year": { "type": "number" }, "minimum_positive_blocks": { "type": "number" }, "maximum_negative_block_expectancy_r": { "type": "number" }, "minimum_doubled_cost_expectancy_r": { "type": "number" }, "minimum_doubled_cost_account_profit_factor": { "type": "number" }, "minimum_coverage_fraction": { "type": "number" }, "maximum_undeclared_gap_bars": { "type": "number" }, "minimum_wfo_oos_episodes": { "type": "number" }, "minimum_wfo_positive_folds": { "type": "number" } } },
        "stress_scenarios": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["name", "required", "parameters"], "properties": { "name": { "type": "string" }, "required": { "const": true }, "parameters": { "type": "object", "additionalProperties": false, "properties": { "multiplier": { "type": "number" }, "minimum_observations": { "type": "integer", "minimum": 1 }, "minimum_expectancy_r": { "type": "number" }, "debit_r": { "type": "number", "minimum": 0 }, "gap_model": { "type": "string" }, "capacity_model": { "type": "string" }, "maximum_participation_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "outage_rule": { "type": "string" }, "blackout_windows": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["venue", "start_time", "end_time"], "properties": { "venue": { "type": "string", "minLength": 1 }, "start_time": { "type": ["string", "number"] }, "end_time": { "type": ["string", "number"] } } } } }, "required": ["minimum_observations", "minimum_expectancy_r"] } } } }
      }
    }
  }
}
