{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-source-bundle/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "plan_sha256", "candidate_set_sha256",
    "envelope_sha256", "acquisition_reference", "hydration_reference",
    "acquisition_sha256", "hydration_sha256", "dataset_root_sha256",
    "root_reference", "storage_role", "authoritative", "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema": { "const": "strategy-v5-source-bundle/1" },
    "version": { "const": 1 },
    "status": { "const": "VERIFIED_COMPLETE" },
    "plan_sha256": { "$ref": "#/$defs/hash" },
    "candidate_set_sha256": { "$ref": "#/$defs/hash" },
    "envelope_sha256": { "$ref": "#/$defs/hash" },
    "acquisition_reference": { "$ref": "#/$defs/physicalReference" },
    "hydration_reference": { "$ref": "#/$defs/physicalReference" },
    "acquisition_sha256": { "$ref": "#/$defs/hash" },
    "hydration_sha256": { "$ref": "#/$defs/hash" },
    "dataset_root_sha256": { "$ref": "#/$defs/hash" },
    "root_reference": { "type": "string", "minLength": 1 },
    "storage_role": { "const": "SOURCE_BUNDLE" },
    "authoritative": { "const": false },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "physicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256", "byte_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/hash" },
        "byte_sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
