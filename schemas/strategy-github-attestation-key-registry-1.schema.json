{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-github-attestation-key-registry/1",
  "type": "object",
  "required": ["schema", "version", "status", "repository", "repository_id", "environment", "keys", "generation", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-github-attestation-key-registry/1"},
    "version": {"const": 1},
    "status": {"const": "FROZEN"},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": ["string", "integer"]},
    "environment": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "keys": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["key_id", "role", "public_key_pem", "fingerprint", "valid_from", "valid_until"], "properties": {"key_id": {"type": "string", "minLength": 1}, "role": {"const": "ACTIONS_ATTESTATION"}, "public_key_pem": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}}, "additionalProperties": false}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
