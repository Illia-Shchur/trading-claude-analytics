{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-prospective-signed-evidence/2",
  "type": "object",
  "required": ["schema", "version", "lineage_sha256", "sequence", "previous_head_sha256", "new_head_sha256", "replay_nonce", "lease_expires_at", "evidence", "evidence_digest_sha256", "required_evidence_sha256", "asset_decision_sha256", "portfolio_decision_sha256", "asset_approval", "portfolio_approval", "replay_entry_sha256", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-prospective-signed-evidence/2"},
    "version": {"const": 2},
    "lineage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "previous_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "new_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replay_nonce": {"type": "string", "minLength": 1},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "evidence_digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "required_evidence_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "asset_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_decision_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "portfolio_decision_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_decision_evidence_id": {"type": "string", "minLength": 1},
    "portfolio_decision_evidence_id": {"type": "string", "minLength": 1},
    "asset_approval": {"type": "object", "required": ["role", "key_id", "signature", "decision_sha256"], "properties": {"role": {"const": "asset"}, "key_id": {"type": "string"}, "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "signature": {"type": "string"}}, "additionalProperties": false},
    "portfolio_approval": {"type": "object", "required": ["role", "key_id", "signature", "decision_sha256"], "properties": {"role": {"const": "portfolio"}, "key_id": {"type": "string"}, "decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "signature": {"type": "string"}}, "additionalProperties": false},
    "replay_entry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trust_root_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trust_root_generation": {"type": "integer", "minimum": 1},
    "trust_root_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replay_sequence": {"type": "integer", "minimum": 1},
    "replay_previous_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "replay_new_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
