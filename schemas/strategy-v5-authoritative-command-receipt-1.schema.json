{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-authoritative-command-receipt/1",
  "type": "object",
  "required": ["schema", "version", "command", "status", "inputs", "outputs", "limitations", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-authoritative-command-receipt/1" },
    "version": { "const": 1 },
    "command": { "enum": ["data-backfill", "data-raw-replay", "data-local-raw-replay", "feature-build", "metadata-build", "opportunity-envelope", "artifact-build", "research-init", "experiment-freeze", "search-genetic", "research-run", "overfit-audit", "prospective-runner", "readiness-audit", "deployment-audit", "validate", "index"] },
    "status": { "enum": ["PLANNED", "COMPLETE", "BLOCKED", "REJECTED"] },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "details": { "$ref": "#/$defs/details" },
    "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string" },
        "pipeline": { "type": "array", "items": { "enum": ["features", "signal_intent", "labels", "execution_fills", "trades", "metrics", "stresses", "portfolio", "wfo"] } },
        "reason": { "type": "string" },
        "record_count": { "type": "integer", "minimum": 0 },
        "plan_sha256": { "$ref": "#/$defs/nullableHash" },
        "catalog_sha256": { "$ref": "#/$defs/nullableHash" },
        "coverage_sha256": { "$ref": "#/$defs/nullableHash" },
        "acquisition_sha256": { "$ref": "#/$defs/nullableHash" },
        "parquet_sha256": { "$ref": "#/$defs/nullableHash" },
        "dataset_root_sha256": { "$ref": "#/$defs/nullableHash" },
        "checkpoint_sha256": { "$ref": "#/$defs/nullableHash" },
        "checkpoint_content_sha256": { "$ref": "#/$defs/nullableHash" },
        "checkpoint_path": { "type": ["string", "null"] },
        "source_checkpoint_sha256": { "$ref": "#/$defs/nullableHash" },
        "source_root": { "type": "string", "minLength": 1 },
        "target_root": { "type": "string", "minLength": 1 },
        "replayed_count": { "type": "integer", "minimum": 0 },
        "retained_count": { "type": "integer", "minimum": 0 },
        "auxiliary_metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["series", "checkpoint_path", "source_checkpoint_sha256", "raw_verified_count", "status", "limitation"],
            "properties": {
              "series": { "type": "string", "minLength": 1 },
              "checkpoint_path": { "type": "string", "minLength": 1 },
              "source_checkpoint_sha256": { "$ref": "#/$defs/nullableHash" },
              "raw_verified_count": { "type": "integer", "minimum": 0 },
              "saved_count": { "type": "integer", "minimum": 0 },
              "remaining_count": { "type": "integer", "minimum": 0 },
              "status": { "enum": ["REPLAYED", "UNAVAILABLE", "PARTIAL_CHECKPOINT_REPLAYED_FOR_NETWORK_RESUME"] },
              "limitation": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "acquisition_status": { "enum": ["STAGING_COMPLETE", "STAGING_PARTIAL"] },
        "base_complete": { "type": "boolean" },
        "declared_complete": { "type": "boolean" },
        "rate_limit_ms": { "type": ["integer", "null"], "minimum": 0 },
        "lock_stale_ms": { "type": ["integer", "null"], "minimum": 0 },
        "envelope_sha256": { "$ref": "#/$defs/nullableHash" },
        "opportunity_domain_sha256": { "$ref": "#/$defs/nullableHash" },
        "hydration_sha256": { "$ref": "#/$defs/nullableHash" },
        "physical_hydration_sha256": { "$ref": "#/$defs/nullableHash" },
        "physical_partition_root_sha256": { "$ref": "#/$defs/nullableHash" },
        "feature_source_sha256": { "$ref": "#/$defs/nullableHash" },
        "spot_execution_policy_sha256": { "$ref": "#/$defs/nullableHash" },
        "metadata_bundle_sha256": { "$ref": "#/$defs/nullableHash" },
        "requirements_sha256": { "$ref": "#/$defs/nullableHash" },
        "promoted_coverage_sha256": { "$ref": "#/$defs/nullableHash" },
        "source_bundle_sha256": { "$ref": "#/$defs/nullableHash" },
        "staging_manifest_sha256": { "$ref": "#/$defs/nullableHash" },
        "parquet_manifest_sha256": { "$ref": "#/$defs/nullableHash" },
        "statistical_artifact_sha256": { "$ref": "#/$defs/nullableHash" },
        "hypothesis_family": { "type": "string", "minLength": 1 },
        "episode_count": { "type": "integer", "minimum": 1 },
        "eligible_episode_count": { "type": "integer", "minimum": 0 },
        "feature_rows": { "type": "integer", "minimum": 0 },
        "label_rows": { "type": "integer", "minimum": 0 },
        "execution_rows": { "type": "integer", "minimum": 0 },
        "mark_rows": { "type": "integer", "minimum": 0 },
        "coverage_status": { "enum": ["READY", "BLOCKED"] },
        "base_only_compatible": { "type": "boolean" },
        "envelope_schema": { "type": ["string", "null"] },
        "hydration_schema": { "type": ["string", "null"] },
        "evaluator_manifest_sha256": { "$ref": "#/$defs/nullableHash" },
        "evaluator_spec_sha256": { "$ref": "#/$defs/nullableHash" },
        "executor_identity_sha256": { "$ref": "#/$defs/nullableHash" },
        "definition_sha256": { "$ref": "#/$defs/nullableHash" },
        "experiment_sha256": { "$ref": "#/$defs/nullableHash" },
        "constraints_sha256": { "$ref": "#/$defs/nullableHash" },
        "training_cutoff": { "type": ["string", "null"], "format": "date-time" },
        "training_phase": { "type": ["string", "null"] },
        "reserved_test_start": { "type": ["string", "null"], "format": "date-time" },
        "training_episode_ids_sha256": { "$ref": "#/$defs/nullableHash" },
        "behavior_registry_sha256": { "$ref": "#/$defs/nullableHash" },
        "behavior_registry_root_sha256": { "$ref": "#/$defs/nullableHash" },
        "exposure_head_sha256": { "$ref": "#/$defs/nullableHash" },
        "genetic_sha256": { "$ref": "#/$defs/nullableHash" },
        "audit_sha256": { "$ref": "#/$defs/nullableHash" },
        "null_controls_sha256": { "$ref": "#/$defs/nullableHash" },
        "ledger_prior_head_sha256": { "$ref": "#/$defs/nullableHash" },
        "ledger_new_head_sha256": { "$ref": "#/$defs/nullableHash" },
        "ledger_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "bound_hashes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evaluator_sha256": { "$ref": "#/$defs/nullableHash" },
            "data_sha256": { "$ref": "#/$defs/nullableHash" },
            "plan_sha256": { "$ref": "#/$defs/nullableHash" },
            "genetic_sha256": { "$ref": "#/$defs/nullableHash" },
            "wfo_sha256": { "$ref": "#/$defs/nullableHash" },
            "selected_fills_sha256": { "$ref": "#/$defs/nullableHash" },
            "stress_sha256": { "$ref": "#/$defs/nullableHash" },
            "portfolio_sha256": { "$ref": "#/$defs/nullableHash" }
            ,"behavior_registry_sha256": { "$ref": "#/$defs/nullableHash" },
            "opportunity_envelope_sha256": { "$ref": "#/$defs/nullableHash" },
            "opportunity_domain_sha256": { "$ref": "#/$defs/nullableHash" },
            "opportunity_hydration_sha256": { "$ref": "#/$defs/nullableHash" },
            "opportunity_partition_root_sha256": { "$ref": "#/$defs/nullableHash" }
          }
        },
        "active": { "const": false },
        "activated": { "const": false }
        ,"publication_artifacts": { "type": "array", "items": { "enum": ["wfo", "research_run", "final_oos_artifact", "final_oos_vector_inventory"] }, "uniqueItems": true, "maxItems": 4 }
        ,"publication_transaction_path": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "required": ["publication_transaction_path"], "properties": { "publication_transaction_path": { "type": "string" } } },
          "then": { "properties": { "publication_artifacts": { "minItems": 4, "maxItems": 4 } } }
        }
      ]
    },
    "reference": {
      "type": "object",
      "required": ["role", "storage", "path", "byte_sha256", "content_sha256", "bytes"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "storage": { "enum": ["PHYSICAL", "INLINE"] },
        "path": { "type": ["string", "null"] },
        "byte_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "content_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "storage": { "const": "PHYSICAL" } } },
          "then": {
            "properties": { "path": { "type": "string", "minLength": 1 }, "byte_sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 } }
          }
        },
        {
          "if": { "properties": { "storage": { "const": "INLINE" } } },
          "then": {
            "required": ["content_sha256"],
            "properties": { "path": { "type": "null" }, "byte_sha256": { "type": "null" }, "content_sha256": { "$ref": "#/$defs/hash" }, "bytes": { "const": 0 } }
          }
        }
      ]
    }
  }
}
