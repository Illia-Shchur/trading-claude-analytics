{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github-writer-installation-receipt/1",
  "type": "object",
  "required": ["schema", "version", "generated_at", "repository", "repository_id", "app_id", "app_slug", "installation_id", "app_endpoint", "app_endpoint_status", "app_endpoint_body_sha256", "installation_endpoint", "installation_endpoint_status", "installation_endpoint_body_sha256", "endpoint", "endpoint_status", "endpoint_body_sha256", "repository_selection", "account", "permissions", "events", "accessible_repository_count", "accessible_repositories", "verified", "content_sha256"],
  "properties": {
    "schema": {"const": "github-writer-installation-receipt/1"},
    "version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": "integer", "minimum": 1},
    "app_id": {"const": 4716299},
    "app_slug": {"const": "strategy-v5-evidence"},
    "installation_id": {"const": 156524819},
    "app_endpoint": {"const": "app"},
    "app_endpoint_status": {"const": 200},
    "app_endpoint_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "installation_endpoint": {"type": "string", "pattern": "^app/installations/[1-9][0-9]*$"},
    "installation_endpoint_status": {"const": 200},
    "installation_endpoint_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "endpoint": {"const": "installation/repositories"},
    "endpoint_status": {"const": 200},
    "endpoint_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_selection": {"const": "selected"},
    "account": {"type": "object", "required": ["id", "login", "type"], "properties": {"id": {"type": "integer", "minimum": 1}, "login": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "permissions": {"type": "object", "required": ["contents", "metadata", "pull_requests"], "properties": {"contents": {"const": "write"}, "metadata": {"const": "read"}, "pull_requests": {"const": "write"}}, "additionalProperties": false},
    "events": {"const": []},
    "accessible_repository_count": {"const": 1},
    "accessible_repositories": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["id", "full_name"], "properties": {"id": {"type": "integer", "minimum": 1}, "full_name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "verified": {"const": true},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
