{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "github-settings-drift-evidence/1",
  "type": "object",
  "required": ["schema", "version", "repository", "repository_id", "evidence_branch", "status", "previous_capture_sha256", "current_capture_sha256", "previous_api_receipt_sha256", "current_api_receipt_sha256", "changed_fields", "compared_at", "content_sha256"],
  "properties": {
    "schema": {"const": "github-settings-drift-evidence/1"},
    "version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": ["string", "integer"]},
    "evidence_branch": {"type": "string", "minLength": 1},
    "status": {"enum": ["BASELINE_ESTABLISHED", "CLEAR", "DRIFTED"]},
    "previous_capture_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "current_capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previous_api_receipt_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "current_api_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "changed_fields": {"type": "array", "items": {"type": "string"}},
    "compared_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
