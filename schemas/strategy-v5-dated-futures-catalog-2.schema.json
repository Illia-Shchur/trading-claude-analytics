{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-dated-futures-catalog/2",
  "type": "object",
  "required": ["schema", "version", "captured_at", "source", "requested_assets", "contracts", "responses", "status", "limitations", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-dated-futures-catalog/2" }, "version": { "const": 2 }, "captured_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "required": ["endpoint", "listing_response_set_sha256", "listing_format", "persistence_status", "raw_receipts", "raw_receipt_sha256", "raw_receipt_byte_sha256"], "properties": { "endpoint": { "type": "string", "format": "uri" }, "listing_response_set_sha256": { "$ref": "#/$defs/hash" }, "listing_format": { "const": "S3_XML_DELIMITER" }, "persistence_status": { "enum": ["HASH_ONLY_UNVERIFIABLE", "RAW_RECEIPTS_BOUND"] }, "raw_output_root_reference": { "type": ["string", "null"] }, "raw_receipts": { "type": "array", "items": { "$ref": "#/$defs/rawReceipt" } }, "raw_receipt_sha256": { "type": "array", "items": { "$ref": "#/$defs/hash" } }, "raw_receipt_byte_sha256": { "type": "array", "items": { "$ref": "#/$defs/hash" } } }, "additionalProperties": false },
    "requested_assets": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "contracts": { "type": "array", "items": { "$ref": "#/$defs/contract" } }, "responses": { "type": "array", "items": { "$ref": "#/$defs/response" } }, "status": { "enum": ["PUBLIC_OBSERVED_PARTIAL", "PUBLIC_OBSERVED_UNAVAILABLE"] }, "limitations": { "type": "array", "items": { "type": "string" } }, "content_sha256": { "$ref": "#/$defs/hash" }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawReceipt": { "type": "object", "required": ["schema", "version", "content_sha256", "path", "byte_sha256", "bytes", "format", "storage_role", "authoritative", "source", "request"], "properties": { "schema": { "const": "strategy-v5-source-receipt/1" }, "version": { "const": 1 }, "content_sha256": { "$ref": "#/$defs/hash" }, "path": { "type": "string" }, "byte_sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 }, "format": { "const": "RAW_BYTES" }, "storage_role": { "const": "RAW_IGNORED" }, "authoritative": { "const": false }, "source": { "const": "BINANCE_DATA_VISION_S3" }, "request": { "type": "object", "required": ["endpoint", "listing_format"], "properties": { "endpoint": { "type": "string", "format": "uri" }, "listing_format": { "const": "S3_XML_DELIMITER" } }, "additionalProperties": false } }, "additionalProperties": false },
    "response": { "type": "object", "required": ["kind", "endpoint"], "properties": { "kind": { "enum": ["LISTING", "HISTORY_PROBE"] }, "endpoint": { "type": "string", "format": "uri" }, "raw_byte_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": ["integer", "null"], "minimum": 0 }, "captured_at": { "type": ["string", "null"], "format": "date-time" }, "raw_receipt_path": { "type": ["string", "null"] }, "raw_receipt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "symbol": { "type": "string" }, "side": { "type": "string" }, "response_sha256": { "type": ["array", "string", "null"], "items": { "$ref": "#/$defs/hash" } } }, "additionalProperties": false },
    "contract": { "type": "object", "required": ["asset", "symbol", "instrument", "history_status", "archive_ingestion_status", "expiry_binding_status", "contract_spec_status", "tradeable", "source_prefix", "source_raw_byte_sha256", "source_listing_response_byte_sha256", "source_receipt_sha256"], "properties": { "asset": { "type": "string" }, "symbol": { "type": "string" }, "contract_type": { "type": "string" }, "venue": { "const": "BINANCE" }, "instrument": { "const": "BINANCE_USDM_DATED_FUTURE" }, "first_bar_at": { "type": ["string", "null"], "format": "date-time" }, "last_bar_at": { "type": ["string", "null"], "format": "date-time" }, "expiry_observed_date_utc": { "type": ["string", "null"] }, "expiry_at": { "type": ["string", "null"], "format": "date-time" }, "expiry_binding_status": { "type": "string" }, "contract_spec_status": { "type": "string" }, "history_status": { "enum": ["SIGNAL_HISTORY_AVAILABLE", "UNAVAILABLE"] }, "archive_ingestion_status": { "enum": ["ARCHIVE_INGESTED", "ARCHIVE_DISCOVERED_NOT_INGESTED", "NOT_APPLICABLE"] }, "tradeable": { "const": false }, "source_prefix": { "type": "string" }, "source_raw_byte_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "source_listing_response_byte_sha256": { "type": "array", "items": { "$ref": "#/$defs/hash" } }, "source_receipt_sha256": { "type": "array", "items": { "$ref": "#/$defs/hash" } }, "archive_coverage_complete": { "type": "boolean" }, "archive_raw_references": { "type": "array", "items": { "$ref": "#/$defs/archiveReference" } } }, "additionalProperties": false },
    "archiveReference": { "type": "object", "required": ["kind", "path", "sha256", "bytes"], "properties": { "kind": { "enum": ["ARCHIVE_ZIP", "ARCHIVE_CHECKSUM"] }, "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/hash" }, "bytes": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
  }
}
