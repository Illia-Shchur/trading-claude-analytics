{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-evidence-summary/1",
  "type": "object",
  "required": [
    "schema", "version", "status", "summary_kind", "display_only",
    "promotion_eligible", "activation_authorized", "source_result",
    "summary", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "strategy-research-evidence-summary/1"},
    "version": {"const": 1},
    "status": {"enum": ["COMPLETE", "BLOCKED", "PREFIX_COMPLETE", "COMPUTE_INCOMPLETE"]},
    "summary_kind": {"enum": ["FIXED_BASELINE_RESULT", "FROZEN_REFINEMENT_MEMBER_RESULT", "OPERATING_CHARACTERISTICS_RESULT"]},
    "display_only": {"const": true},
    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "source_result": {
      "type": "object",
      "required": ["path", "byte_sha256", "content_sha256", "bytes", "original_schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byte_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "original_schema": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "summary": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
