{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-fixed-baseline-signal-producer-receipt/1",
  "type": "object",
  "required": ["schema", "version", "status", "producer_schema", "source_manifest_path", "source_manifest_sha256", "signal_role_content_sha256", "declared_assets", "asset_counts", "coverage_start_ms", "coverage_end_ms", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-fixed-baseline-signal-producer-receipt/1"},
    "version": {"const": 1},
    "status": {"const": "VERIFIED_PHYSICAL"},
    "producer_schema": {"const": "strategy-fixed-baseline-signal-bars/1"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signal_role_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "declared_assets": {"type": "array", "minItems": 1},
    "asset_counts": {"type": "object"},
    "coverage_start_ms": {"type": "integer"},
    "coverage_end_ms": {"type": "integer"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
