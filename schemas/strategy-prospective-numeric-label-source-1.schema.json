{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-prospective-numeric-label-source/1",
  "type": "object",
  "required": ["schema", "version", "completed_bar_id", "decision_lineage_sha256", "trades", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-prospective-numeric-label-source/1"},
    "version": {"const": 1},
    "asset": {"type": "string", "pattern": "^[a-z0-9]+$"},
    "completed_bar_id": {"type": "string", "minLength": 1},
    "decision_lineage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trades": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["trade_id", "resolution_time"], "properties": {"trade_id": {"type": "string", "minLength": 1}, "resolution_time": {"type": "string", "format": "date-time"}}, "additionalProperties": false}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
