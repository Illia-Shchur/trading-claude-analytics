    "evidence_tier", "authoritative_wfo_permitted", "sealed_confirmation_permitted", "prospective_live_permitted",
    "trade_authorization_permitted", "candidate_returns_inspected", "assets", "instrument_scope", "clocks",
    "windows", "physical_data_contract", "capital_and_risk", "lifecycle_contract", "fold_contract",
