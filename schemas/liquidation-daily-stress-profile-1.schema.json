    "precommit_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strategy_family": { "const": "liquidation-structure" },
    "evidence_tier": { "const": "DEVELOPMENT_ONLY" },
    "authoritative_wfo_permitted": { "const": false },
    "sealed_confirmation_permitted": { "const": false },
    "prospective_live_permitted": { "const": false },
    "trade_authorization_permitted": { "const": false },
    "candidate_returns_inspected": { "const": false },
    "assets": { "const": ["BTC", "ETH", "SOL", "AAVE"] },
    "instrument_scope": { "type": "object" },
    "clocks": { "type": "object" },
    "windows": { "type": "object" },
    "physical_data_contract": { "type": "object" },
    "capital_and_risk": { "type": "object" },
    "lifecycle_contract": { "type": "object" },
    "fold_contract": { "type": "object" },
    "core_variants": { "const": ["ROUTED_REVERSAL_CONTINUATION", "ALWAYS_CONTINUATION_CONTROL", "ALWAYS_REVERSAL_CONTROL", "PRICE_OI_ONLY_EVENT_DIAGNOSTIC"] },
    "declared_core_variant_count": { "const": 4 },
    "variant_selection": { "const": "FROZEN_NO_OPTIMIZATION" },
    "qualification_requirements": { "type": "array", "minItems": 8 },
    "executor_capability": { "const": "liquidation-v2-physical-parquet-v1" },
    "executor_identity_must_bind": { "const": "SOURCE_BYTES_POLICY_DATA_MANIFEST_ROLE_PARTITIONS_AND_RUNTIME" },
    "caller_supplied_fills_or_verified_flags_authoritative": { "const": false },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
