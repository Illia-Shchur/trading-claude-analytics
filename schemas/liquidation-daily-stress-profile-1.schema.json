{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liquidation-daily-stress-profile/1",
  "title": "liquidation-daily-stress-profile/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
