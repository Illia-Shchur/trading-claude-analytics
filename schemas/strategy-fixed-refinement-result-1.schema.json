{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-fixed-refinement-result/1",
  "type": "object",
  "required": [
    "schema", "version", "stage", "evidence_phase", "promotion_eligible",
    "activation_authorized", "outcomes_opened", "optimizer_invoked",
    "candidate_count", "max_attempts", "refinement_plan_sha256",
    "baseline_sha256", "control_spec_sha256", "experiment_sha256",
    "predecessor_sha256", "exposure_head_sha256", "shared_physical_evaluator",
    "members", "status", "content_sha256"
  ],
  "properties": {
    "schema": {"const": "strategy-fixed-refinement-result/1"},
    "version": {"const": 1},
    "stage": {"const": "FROZEN_REFINEMENT"},
    "evidence_phase": {"const": "DIAGNOSTIC"},
    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "outcomes_opened": {"const": true},
    "optimizer_invoked": {"const": false},
    "candidate_count": {"const": 3},
    "max_attempts": {"const": 3},
    "refinement_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "control_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "experiment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "predecessor_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exposure_head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shared_physical_evaluator": {"const": true},
    "members": {"type": "array", "minItems": 3, "maxItems": 3},
    "status": {"enum": ["COMPLETE", "COMPUTE_INCOMPLETE"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
