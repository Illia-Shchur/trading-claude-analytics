{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-actions-only-secret-evidence/1",
  "type": "object",
  "required": ["schema", "version", "status", "scope", "repository", "repository_id", "environment", "secret_name", "environment_secret_status", "environment_secret_body_sha256", "repository_secret_status", "repository_secret_body_sha256", "organization_secret_status", "organization_secret_body_sha256", "settings_capture_sha256", "api_receipt_sha256", "attestation_sha256", "registry_sha256", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-actions-only-secret-evidence/1"},
    "version": {"const": 1},
    "status": {"const": "BOUND"},
    "scope": {"const": "ACTIONS_ATTESTATION_ONLY"},
    "repository": {"type": "string", "minLength": 1},
    "repository_id": {"type": ["string", "integer"]},
    "environment": {"const": "prospective-v5"},
    "secret_name": {"type": "string", "minLength": 1},
    "environment_secret_status": {"type": "integer", "minimum": 0},
    "environment_secret_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_secret_status": {"type": "integer", "minimum": 0},
    "repository_secret_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "organization_secret_status": {"type": "integer", "minimum": 0},
    "organization_secret_body_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "settings_capture_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "api_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "attestation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
