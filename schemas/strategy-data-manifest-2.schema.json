{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-data-manifest/2",
  "type": "object",
  "required": ["schema", "manifest_id", "role", "datasets", "lineage", "data_root_sha256", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-data-manifest/2" }, "manifest_id": { "type": "string", "minLength": 1 }, "snapshot_id": { "type": ["string", "null"] },
    "role": { "enum": ["RAW", "NORMALIZED", "FEATURE", "LABEL", "CONTEXT"] }, "source": { "type": "string" }, "public_source": { "type": "boolean" },
    "partitioning": { "type": "array" }, "lineage": { "type": "object", "required": ["adapter_sha256", "code_sha256", "container_sha256", "config_sha256"], "properties": { "adapter_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "code_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "container_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }, "data_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string" }, "authoritative": { "type": "boolean" }, "coverage_summary": { "type": "object", "properties": { "price_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "derivatives_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "funding_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }, "additionalProperties": false }, "label_coverage_summary": { "type": "object", "properties": { "price_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "derivatives_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }, "funding_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 } }, "additionalProperties": false }, "feature_store": { "type": ["object", "null"], "properties": { "path": { "type": "string" }, "format": { "enum": ["parquet", "jsonl"] }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 }, "row_count": { "type": "integer", "minimum": 0 }, "labels": { "anyOf": [{ "$ref": "#/$defs/artifact" }, { "type": "null" }] }, "partitions": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "label_partitions": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }, "input_bytes_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "raw_path": { "type": "string" }, "raw_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "normalized_path": { "type": "string" }, "normalized_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "quality_path": { "type": "string" }, "quality_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }, "datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } }, "label_datasets": { "type": "array", "items": { "$ref": "#/$defs/dataset" } }, "gaps": { "type": "array", "items": { "type": "object" } }
  }, "additionalProperties": false
  , "$defs": {
    "artifact": { "type": "object", "required": ["path", "sha256", "format", "row_count"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "format": { "enum": ["parquet", "jsonl"] }, "bytes": { "type": "integer", "minimum": 0 }, "rows": { "type": "integer", "minimum": 0 }, "row_count": { "type": "integer", "minimum": 0 }, "audit": { "const": true } }, "additionalProperties": false },
    "dataset": { "type": "object", "required": ["dataset_id", "row_count", "source_sha256", "availability_time_policy", "point_in_time_status", "revision_status"], "properties": { "dataset_id": { "type": "string" }, "dataset_version": { "type": "string" }, "asset": { "type": "string" }, "asset_class": { "type": "string" }, "venue": { "type": ["string", "null"] }, "instrument_id": { "type": ["string", "null"] }, "timeframe": { "type": ["string", "null"] }, "row_count": { "type": "integer", "minimum": 0 }, "min_time": { "type": ["number", "null"] }, "max_time": { "type": ["number", "null"] }, "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "availability_time_policy": { "type": "string" }, "point_in_time_status": { "type": "string" }, "revision_status": { "type": "string" }, "pit_tiers": { "type": "array", "items": { "type": "string" } }, "coverage": { "type": "object", "properties": { "expected_rows": { "type": "integer", "minimum": 0 }, "observed_rows": { "type": "integer", "minimum": 0 }, "observed_fraction": { "type": "number", "minimum": 0 }, "gap_count": { "type": "integer", "minimum": 0 }, "max_gap_bars": { "type": "integer", "minimum": 0 }, "minimum_fraction": { "type": "number", "minimum": 0, "maximum": 1 }, "frozen": { "const": true } }, "additionalProperties": false }, "source": { "type": "string" }, "public_source": { "type": "boolean" }, "role": { "type": "string" } }, "additionalProperties": false }
  }
}
