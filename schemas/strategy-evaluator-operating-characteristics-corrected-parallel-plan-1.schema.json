{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-evaluator-operating-characteristics-corrected-parallel-plan/1",
  "type": "object",
  "required": ["schema", "version", "frozen_before_outcomes", "outcomes_opened", "promotion_eligible", "activation_authorized", "development_wave", "development_worker_count", "corrected_evaluator_identity", "accounting_version", "cells", "development_seed_cells", "development_prefix_seed_cells", "cell_count", "replications", "episodes_per_replication", "cluster_count", "paired_cluster_count", "lifecycle_series_per_replication", "horizon_minutes", "statistical_plan_sha256", "baseline_sha256", "control_spec_sha256", "experiment_sha256", "executor_source_sha256", "executor_build_input_fingerprint", "executor_identity_sha256", "execution_profile_sha256", "supporting_dependency_receipts", "content_sha256"],
  "properties": {
