    "version": {"const": 1},
    "frozen_before_outcomes": {"const": true},
    "outcomes_opened": {"const": false},
    "promotion_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "development_wave": {"const": true},
    "development_worker_count": {"type": "integer", "minimum": 1},
    "corrected_evaluator_identity": {"const": "com.tradinganalytics.research.v5.StrategyFixedBaselineCorrectedV1"},
    "fixed_evaluator": {"const": "com.tradinganalytics.research.v5.StrategyFixedBaselineCorrectedV1"},
    "accounting_version": {"const": "PORTFOLIO_ACCOUNTING_CORRECTION_V1"},
    "mode": {"enum": ["FULL", "PREFIX"]},
    "cells": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "development_seed_cells": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["scenario", "effect_size", "development_seeds"], "properties": {"scenario": {"type": "string"}, "effect_size": {"type": "number"}, "development_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}}}, "additionalProperties": true}},
    "development_prefix_seed_cells": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["scenario", "effect_size", "prefix_seeds"], "properties": {"scenario": {"type": "string"}, "effect_size": {"type": "number"}, "prefix_seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}}}, "additionalProperties": true}},
    "cell_count": {"const": 4},
    "replications": {"const": 75},
    "episodes_per_replication": {"const": 450},
    "cluster_count": {"const": 288},
    "paired_cluster_count": {"const": 162},
    "lifecycle_series_per_replication": {"const": 900},
    "horizon_minutes": {"const": 14400},
    "statistical_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "control_spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "experiment_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor_source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor_build_input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "executor_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "supporting_dependency_receipts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
