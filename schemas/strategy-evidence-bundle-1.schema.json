{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-evidence-bundle/1",
  "type": "object",
  "required": ["schema", "bundle_version", "provenance", "evidence_phase", "experiment_id", "strategy_id", "required_assets", "precommit_sha256", "definition_sha256", "experiment_sha256", "candidate_set_sha256", "data_manifest_sha256", "feature_store_sha256", "executor", "candidate_accounting", "metrics", "trades", "reconciliation", "decisions", "activation", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-evidence-bundle/1" }, "bundle_version": { "const": 1 }, "provenance": { "const": "AUTHORITATIVE_RECOMPUTED" },
    "evidence_phase": { "enum": ["DEVELOPMENT", "WALK_FORWARD_OOS", "EXPOSED_CONFIRMATION", "PROSPECTIVE_LIVE"] },
    "experiment_id": { "type": "string" }, "candidate_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executor": { "type": "object", "required": ["adapter_id", "adapter_version", "source_file_sha256", "source_files", "feature_store_sha256", "feature_store_artifact_sha256", "data_manifest_sha256", "data_manifest_artifact_sha256", "package_lock_sha256", "environment_sha256", "code_config_sha256", "identity_sha256", "seed_ledger", "timezone", "bar_convention", "same_bar_collision_policy", "cost_funding_assumptions"], "properties": { "source_files": { "type": "object", "required": ["swing_engine", "authoritative_evaluator", "portfolio_simulator"], "properties": { "swing_engine": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "authoritative_evaluator": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "portfolio_simulator": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } } },
    "metrics": { "type": "array" }, "trades": { "type": "array" }, "selected_trades": { "type": "array" }, "input_artifacts": { "type": "object" },
    "reconciliation": { "type": "object", "required": ["candidate_trade_set_sha256", "all_trades_sha256", "selected_trades_sha256", "derived_metrics_sha256", "stress_result_sha256", "portfolio_source_sha256", "portfolio_result_sha256"] },
    "decisions": { "type": "object", "required": ["per_asset", "portfolio"] },
    "activation": { "type": "object", "required": ["authorized", "status"], "properties": { "authorized": { "const": false }, "status": { "const": "SHADOW" } } },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
