{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-v5-opportunity-envelope/2",
  "type": "object",
  "required": ["schema", "version", "status", "fixture_only", "provenance", "plan_sha256", "precommit_sha256", "predictor_registry_sha256", "evaluator_spec_sha256", "graph_sha256", "candidate_set_sha256", "opportunity_domain_sha256", "gene_space_sha256", "max_lifecycle_ms", "execution_interval_ms", "opportunity_predicate", "windows", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-v5-opportunity-envelope/2" },
    "version": { "const": 2 },
    "status": { "const": "FROZEN" },
    "fixture_only": { "type": "boolean" },
    "provenance": { "type": "string", "minLength": 1 },
    "plan_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "precommit_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "predictor_registry_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "evaluator_spec_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "graph_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "candidate_set_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "opportunity_domain_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "gene_space_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "max_lifecycle_ms": { "type": "integer", "exclusiveMinimum": 0 },
    "execution_interval_ms": { "type": "integer", "exclusiveMinimum": 0 },
    "lifecycle_timeframe": { "type": "string", "minLength": 1 },
    "opportunity_predicate": { "type": "object", "minProperties": 1 },
    "predicate_predictor_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "predicate_semantics": { "type": "string", "minLength": 1 },
    "candidate_domain_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "predeclared_candidate_count": { "type": ["integer", "null"], "minimum": 1 },
    "subset_audit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "subset_audit_count": { "type": "integer", "minimum": 0 },
    "assets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "instruments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "windows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["window_id", "asset", "instrument", "symbol", "episode_id", "signal_id", "decision_time", "preentry_start", "preentry_warmup_bars", "execution_start", "entry_time", "execution_end", "max_lifecycle_ms", "lifecycle_timeframe", "candidate_subset_required", "right_edge_terminal_policy", "source_row_sha256"],
        "properties": {
          "window_id": { "type": "string", "minLength": 1 },
          "asset": { "type": "string", "minLength": 1 },
          "instrument": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "episode_id": { "type": ["string", "null"] },
          "signal_id": { "type": ["string", "null"] },
          "decision_time": { "type": "string", "format": "date-time" },
          "preentry_start": { "type": "string", "format": "date-time" },
          "preentry_warmup_bars": { "type": "integer", "minimum": 0 },
          "execution_start": { "type": "string", "format": "date-time" },
          "entry_time": { "type": "string", "format": "date-time" },
          "execution_end": { "type": "string", "format": "date-time" },
          "max_lifecycle_ms": { "type": "integer", "exclusiveMinimum": 0 },
          "lifecycle_timeframe": { "type": "string", "minLength": 1 },
          "candidate_subset_required": { "const": true },
          "right_edge_terminal_policy": { "const": "UNRESOLVED_UNLESS_DECLARED_EXPIRY" },
          "source_row_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_feature_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
