{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-data-manifest/1",
  "type": "object",
  "required": ["schema", "manifest_id", "feature_store", "datasets"],
  "properties": {
    "schema": { "const": "strategy-data-manifest/1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "feature_store": {
      "type": "object",
      "required": ["sha256"],
      "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "row_count": { "type": "integer", "minimum": 0 } },
      "additionalProperties": true
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dataset_id", "row_count", "min_time", "max_time", "source_sha256", "availability_time_policy", "point_in_time_status", "revision_status"],
        "properties": {
          "dataset_id": { "type": "string" }, "asset": { "type": "string" }, "venue": { "type": "string" }, "trade_venue": { "type": "string" }, "symbol": { "type": "string" }, "instrument_id": { "type": "string" },
          "row_count": { "type": "integer", "minimum": 0 }, "min_time": {}, "max_time": {},
          "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "availability_time_policy": { "type": "string", "minLength": 1 },
          "point_in_time_status": { "enum": ["VERIFIED", "PIT_SAFE", "COMPLETED_BAR", "PROXY_DISCLOSED", "UNKNOWN", "NON_PIT", "REVISED"] },
          "revision_status": { "enum": ["ORIGINAL", "UNREVISED", "NOT_REVISED", "FROZEN", "FINAL", "REALTIME", "LIVE", "PIT_SAFE", "REVISED", "PROXY_DISCLOSED", "NON_PIT", "UNKNOWN"] }, "availability_time_field": { "type": "string" }, "coverage": { "type": "object", "properties": { "gap_count": { "type": "integer", "minimum": 0 }, "frozen": { "type": "boolean" }, "minimum_fraction": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
