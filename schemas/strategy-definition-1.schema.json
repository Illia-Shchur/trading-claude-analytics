{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-definition/1",
  "type": "object",
  "required": ["schema", "strategy_id", "version", "created_at", "lineage", "candidate_template", "feature_contract", "evidence_policy"],
  "properties": {
    "schema": { "const": "strategy-definition/1" },
    "strategy_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^v[0-9]{3}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "lineage": { "type": "object", "required": ["parent_version", "change_summary"], "properties": { "parent_version": { "type": ["string", "null"] }, "change_summary": { "type": "string" } } },
    "status": { "enum": ["DRAFT", "FROZEN", "REJECTED", "RETIRED"] },
    "candidate_template": { "type": "object" },
    "feature_contract": { "type": "object", "required": ["series", "inputs"], "properties": {
      "series": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["series_id", "asset", "timeframe", "point_in_time"] } },
      "inputs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["input_id", "field_path", "source", "transformation", "availability", "point_in_time", "minimum_coverage", "role"] } }
    } },
    "evidence_policy": { "type": "object", "required": ["activation_allowed"], "properties": { "activation_allowed": { "const": false } } }
  }
}
