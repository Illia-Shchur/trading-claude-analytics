{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-prospective-decision/1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "asset",
    "role",
    "decision",
    "lineage_sha256",
    "content_sha256",
    "evidence_sha256",
    "workflow_attestation_sha256"
  ],
  "properties": {
    "schema": {
      "const": "strategy-prospective-decision/1"
    },
    "version": {
      "const": 1
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "asset",
        "portfolio"
      ]
    },
    "decision": {
      "enum": [
        "PASS",
        "BLOCKED",
        "SHADOW"
      ]
    },
    "lineage_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "workflow_attestation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
