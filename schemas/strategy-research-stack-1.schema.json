{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-stack/1",
  "type": "object",
  "required": ["schema", "stack_id", "precommit_sha256", "definition_sha256", "candidate_set_sha256", "acceptance_sha256", "executor_sha256", "environment_sha256", "exposure_ledger_sha256", "lineage", "universe", "generation", "data", "execution", "statistics", "portfolio_policy", "evidence_phase", "decision", "content_sha256"],
  "properties": {
    "schema": { "const": "strategy-research-stack/1" },
    "stack_id": { "type": "string", "minLength": 1 },
    "precommit_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "acceptance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "environment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "exposure_ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lineage": { "type": "object", "required": ["definition_sha256", "acceptance_sha256", "executor_sha256", "environment_sha256", "exposure_ledger_sha256"], "additionalProperties": false, "properties": { "definition_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "acceptance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "executor_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "environment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "exposure_ledger_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "universe": { "type": "object", "required": ["tradable_assets", "excluded_assets", "venue"], "properties": { "tradable_assets": { "type": "array", "minItems": 1 }, "excluded_assets": { "type": "array" }, "venue": { "const": "binance" }, "instrument_scope": { "type": "array" } }, "additionalProperties": false },
    "generation": { "type": "object", "required": ["method", "declared_k", "effective_k", "seed", "provenance"], "properties": { "method": { "enum": ["GRID", "RANDOM", "GENETIC", "ML"] }, "declared_k": { "type": "integer", "minimum": 0 }, "effective_k": { "type": "integer", "minimum": 0 }, "seed": { "type": "integer" }, "provenance": { "type": "object" } }, "additionalProperties": true },
    "data": { "type": "object", "required": ["manifest_sha256", "feature_set_sha256", "label_set_sha256", "pit_policy"], "properties": { "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "feature_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "label_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "pit_policy": { "type": "object" }, "coverage": { "type": "object" } }, "additionalProperties": true },
    "execution": { "type": "object", "required": ["schema", "venue", "order_types", "bar_convention", "same_bar_collision", "capacity_model", "content_sha256"], "properties": { "schema": { "const": "strategy-execution-policy/1" }, "venue": { "const": "binance" }, "order_types": { "type": "array" }, "bar_convention": { "type": "string" }, "same_bar_collision": { "enum": ["ADVERSE", "STOP_FIRST", "TARGET_FIRST"] }, "capacity_model": { "type": "object", "required": ["type", "default_max_rate", "reject_unfilled_residual"], "properties": { "type": { "type": "string" }, "default_max_rate": { "type": "number" }, "reject_unfilled_residual": { "type": "boolean" } }, "additionalProperties": true }, "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": true },
    "statistics": { "type": "object", "required": ["selection", "resampling", "plateau", "ablations"], "properties": { "selection": { "type": "object" }, "resampling": { "type": "object" }, "plateau": { "type": "object" }, "ablations": { "type": ["array", "object"] } }, "additionalProperties": true },
    "portfolio_policy": { "type": "object" },
    "evidence_phase": { "enum": ["DEVELOPMENT", "WALK_FORWARD_OOS", "EXPOSED_CONFIRMATION", "CI_ATTESTED_CONFIRMATION", "PROSPECTIVE_LIVE"] },
    "decision": { "enum": ["REJECTED", "SHADOW", "CANDIDATE_REVIEW"] },
    "activation": { "type": "object" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
