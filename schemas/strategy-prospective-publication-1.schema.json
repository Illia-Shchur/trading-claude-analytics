{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-prospective-publication/1",
  "type": "object",
  "required": ["schema", "version", "completed_bar_sha256", "sequence", "asset_approval", "portfolio_approval", "replay_nonce", "issued_at", "lease_expires_at", "content_sha256"],
  "properties": {"schema": {"const": "strategy-prospective-publication/1"}, "version": {"const": 1}, "completed_bar_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sequence": {"type": "integer", "minimum": 1}, "asset_approval": {"$ref": "#/$defs/approval", "properties": {"role": {"const": "ASSET"}}}, "portfolio_approval": {"$ref": "#/$defs/approval", "properties": {"role": {"const": "PORTFOLIO"}}}, "replay_nonce": {"type": "string", "minLength": 16}, "issued_at": {"type": "string"}, "lease_expires_at": {"type": "string"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "$defs": {"approval": {"type": "object", "required": ["role", "key_id", "signature", "public_key_pem"], "properties": {"role": {"enum": ["ASSET", "PORTFOLIO"]}, "key_id": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}, "public_key_pem": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
  "additionalProperties": false
}
