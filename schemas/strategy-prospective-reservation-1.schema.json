{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-prospective-reservation/1",
  "type": "object",
  "required": ["schema", "version", "status", "decision", "lineage_sha256", "frozen_start", "frozen_end", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-prospective-reservation/1"},
