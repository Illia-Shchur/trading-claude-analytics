    "status": {"const": "FROZEN"},
    "decision": {"const": "SHADOW"},
    "lineage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frozen_start": {"type": "string", "format": "date-time"},
    "frozen_end": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
