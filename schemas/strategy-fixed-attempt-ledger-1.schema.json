{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-fixed-attempt-ledger/1",
  "type": "object",
  "required": ["schema", "family", "head_sha256", "pairs", "content_sha256"],
  "properties": {
    "schema": {"const": "strategy-fixed-attempt-ledger/1"},
    "family": {"type": "string", "minLength": 1},
    "head_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["behavior_sha256", "dataset_sha256"],
        "properties": {
          "behavior_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
