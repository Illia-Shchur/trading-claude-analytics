# Cross-repo exchange (accounting → analytics).
# Historical position snapshots are intentionally retained in exports/ and committed by
# explicit user action. They carry real balances, ACB cost basis, open positions and
# realized PnL; verify the remote visibility before pushing a snapshot commit.
/exchange/
/data/
*.snapshot.json
exports/*.tmp
node_modules/

# report-machine/2 draft and renderer scratch (never committed)
/.report-run/

# framework-calibration run scratch (corpus slices, digests, manifests) —
# reproducible from reports/ on demand, not repo state.
/.calib-run/
